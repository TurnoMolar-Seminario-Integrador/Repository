@{
    ViewData["Title"] = "Comprobante de Turno - Clínica Dental Rosario";
    ViewData["ActiveTab"] = "MisTurnos";
    Layout = "_LayoutPaciente";

    // Todos los datos salen del turno (TurnoController.Comprobante). Antes, si el controlador no cargaba
    // una clave, la vista mostraba datos de ejemplo ("Manuel Fernández", "OSDE - Plan 210",
    // "TM-2026-8491A") y el estado era siempre "HABILITADO" (el del paciente, no el del turno).
    var nombrePaciente = ViewData["NombrePaciente"]?.ToString() ?? "";
    var fechaTurno = ViewData["FechaTurno"]?.ToString() ?? "";
    var doctor = ViewData["Doctor"]?.ToString() ?? "";
    var especialidad = ViewData["Especialidad"]?.ToString() ?? "";
    var cobertura = ViewData["MetodoPago"]?.ToString() ?? "";
    var estadoTurno = ViewData["EstadoTurno"]?.ToString() ?? "";
    var fechaEmision = ViewData["FechaEmision"]?.ToString();
    // El código es el número del comprobante emitido al reservar (CUU01). Un turno sin comprobante no
    // tiene código ni QR: no se inventa uno.
    var codigoReserva = ViewData["CodigoReserva"]?.ToString();
    var tieneCodigo = !string.IsNullOrEmpty(codigoReserva);

    // El título refleja el estado real: solo un turno reservado está "confirmado"; el comprobante de uno
    // cancelado, ausente o ya atendido sigue pudiendo consultarse desde Mis Turnos.
    var turnoReservado = estadoTurno == "RESERVADO";
}

@section Styles {
    <style>
        .ticket-container {
            width: 100%;
            max-width: 520px;
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 12px 35px rgba(0,0,0,0.06);
            overflow: hidden;
            border: 1px solid #e2e8f0;
            margin: 0 auto;
        }

        .ticket-header {
            background: linear-gradient(135deg, #0d3b66 0%, #1e40af 100%);
            color: #ffffff;
            padding: 28px 24px;
            text-align: center;
            position: relative;
        }

        .ticket-body {
            padding: 28px 32px;
        }

        .ticket-divider {
            border-top: 2px dashed #cbd5e1;
            margin: 0;
            position: relative;
        }

        .ticket-divider::before, .ticket-divider::after {
            content: '';
            position: absolute;
            top: -15px;
            width: 30px;
            height: 30px;
            background-color: #f4f7fb;
            border-radius: 50%;
        }

        .ticket-divider::before {
            left: -15px;
        }

        .ticket-divider::after {
            right: -15px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            color: #64748b;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-value {
            font-weight: 700;
            color: #1e293b;
            text-align: right;
            font-size: 0.95rem;
        }
    </style>
}

<div class="text-center mb-4">
    @if (turnoReservado)
    {
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 72px; height: 72px; background-color: #dcfce7; color: #16a34a;">
            <i class="bi bi-check-lg" style="font-size: 2.4rem;"></i>
        </div>
        <h2 class="fw-extrabold text-dark mb-1">¡Turno Confirmado!</h2>
        <p class="text-muted small mb-0">Tu cita ha sido agendada con éxito en el sistema.</p>
    }
    else
    {
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 72px; height: 72px; background-color: #e0e7ff; color: #3730a3;">
            <i class="bi bi-receipt" style="font-size: 2.2rem;"></i>
        </div>
        <h2 class="fw-extrabold text-dark mb-1">Comprobante de turno</h2>
        <p class="text-muted small mb-0">Estado actual del turno: <strong>@estadoTurno</strong></p>
    }
</div>

<!-- TICKET DIGITAL (BSQ Pág 6) -->
<div class="ticket-container mb-4" id="ticketArea">
    <div class="ticket-header">
        <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" width="42" class="mb-2 bg-white rounded-circle p-1">
        <h4 class="fw-extrabold mb-0">Clínica Dental Rosario</h4>
        <small class="text-white-50">Comprobante Oficial de Reserva</small>
    </div>

    <div class="ticket-divider"></div>

    <div class="ticket-body">
        @if (tieneCodigo)
        {
            <div class="text-center mb-4 pb-3 border-bottom" id="bloqueCodigoComprobante">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=@Uri.EscapeDataString(codigoReserva!)" alt="QR Code" class="mb-2 rounded p-1 border">
                <p class="small text-muted mb-0 fw-semibold">CÓDIGO DE COMPROBANTE</p>
                <h4 class="fw-extrabold text-primary mb-0" id="codigoComprobante" style="letter-spacing: 2px;">@codigoReserva</h4>
            </div>
        }

        <div class="detail-row">
            <span class="detail-label">Paciente</span>
            <span class="detail-value">@nombrePaciente</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Profesional</span>
            <span class="detail-value">@doctor</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Especialidad</span>
            <span class="detail-value">@especialidad</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Fecha y Hora</span>
            <span class="detail-value text-primary">@fechaTurno</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Cobertura</span>
            <span class="detail-value text-success" id="coberturaComprobante">@cobertura</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Sede / Ubicación</span>
            <span class="detail-value">Consultorio 2 • Sede Centro</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Estado del turno</span>
            @if (turnoReservado)
            {
                <span class="detail-value text-success" id="estadoComprobante"><i class="bi bi-check-circle-fill me-1"></i> @estadoTurno</span>
            }
            else
            {
                <span class="detail-value" id="estadoComprobante">@estadoTurno</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(fechaEmision))
        {
            <div class="detail-row">
                <span class="detail-label">Emitido</span>
                <span class="detail-value" id="emisionComprobante">@fechaEmision</span>
            </div>
        }
    </div>
</div>

<!-- ACCIONES -->
<div class="d-flex flex-wrap gap-3 justify-content-center">
    <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm bg-white">
        <i class="bi bi-printer me-2"></i>Imprimir / Guardar PDF
    </button>
    <a href="@Url.Action("MisTurnos", "Home")" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">
        Ir a Mis Turnos <i class="bi bi-arrow-right ms-2"></i>
    </a>
    <a href="@Url.Action("Index", "Home")" class="btn btn-light rounded-pill px-4 fw-semibold border shadow-sm">
        Volver al Inicio
    </a>
</div>