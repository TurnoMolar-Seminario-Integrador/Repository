@model IEnumerable<DTOs.TurnoAgendaDelDiaDTO>
@{
    ViewData["Title"] = "Turnos del Día - Clínica Dental Rosario";
    ViewData["ActiveTab"] = "TurnosDelDia";
    Layout = "_LayoutOdontologo";
}

@section Styles {
    <style>
        .turno-row {
            background: #ffffff;
            border: 1px solid #eaeaea;
            border-radius: 12px;
            padding: 18px 22px;
            margin-bottom: 14px;
            border-left: 5px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            transition: all 0.2s;
            flex-wrap: wrap;
            gap: 12px;
        }

        .turno-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.05);
        }

        .turno-espera  { border-left-color: #f59e0b; background: #fffdfa; }
        .turno-atendido { border-left-color: #10b981; opacity: 0.85; background: #fbfdfc; }
        .turno-ausente { border-left-color: #ef4444; opacity: 0.85; background: #fffafa; }

        .turno-hora {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0d3b66;
            min-width: 95px;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Agenda de Hoy</h2>
        <p class="text-muted mb-0">Listado de tus pacientes citados para hoy y su estado real de asistencia.</p>
    </div>
    <button class="btn btn-outline-primary rounded-pill fw-semibold shadow-sm" onclick="window.print();">
        <i class="bi bi-printer me-2"></i>Imprimir Agenda
    </button>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["MensajeAdvertencia"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["MensajeAdvertencia"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary rounded-4 border-0 shadow-sm">
        <i class="bi bi-calendar-x me-2"></i> No tenés turnos programados para hoy.
    </div>
}

@foreach (var t in Model)
{
    var rowClass = t.EstadoTurno switch
    {
        "PRESENTE" => "turno-espera",
        "ATENCION_REGISTRADA" or "FINALIZADO" => "turno-atendido",
        "AUSENTE" => "turno-ausente",
        _ => ""
    };

    <div class="turno-row @rowClass">
        <div class="d-flex align-items-center gap-4">
            <div class="turno-hora @(t.EstadoTurno == "RESERVADO" ? "text-secondary" : "")">@t.FechaHoraTurno.ToString("HH:mm")</div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">@t.NombrePaciente @t.ApellidoPaciente</h6>
                <p class="text-muted small mb-0">
                    <i class="bi bi-card-text me-1 text-primary"></i> @t.NombreEspecialidad • @t.ModalidadPago
                    @if (!string.IsNullOrWhiteSpace(t.DescripcionMaterial))
                    {
                        <text> • @t.DescripcionMaterial</text>
                    }
                </p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            @switch (t.EstadoTurno)
            {
                case "PRESENTE":
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2 rounded-pill">
                        <i class="bi bi-person-check me-1"></i> En Sala de Espera
                    </span>
                    <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm btn-iniciar-atencion"
                            data-bs-toggle="modal" data-bs-target="#modalRegistrarAtencion"
                            data-nro-turno="@t.NroTurno" data-nombre-paciente="@t.NombrePaciente @t.ApellidoPaciente">
                        <i class="bi bi-journal-plus me-1"></i> Iniciar Atención
                    </button>
                    break;
                case "RESERVADO":
                    <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                        <i class="bi bi-clock me-1"></i> Pendiente Admisión
                    </span>
                    <button class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" disabled>
                        Esperando Llegada
                    </button>
                    break;
                case "AUSENTE":
                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger px-3 py-2 rounded-pill">
                        <i class="bi bi-person-x me-1"></i> Ausente
                    </span>
                    break;
                case "ATENCION_REGISTRADA":
                    <span class="badge bg-info-subtle text-info-emphasis border border-info px-3 py-2 rounded-pill">
                        <i class="bi bi-hourglass-split me-1"></i> Pendiente Cobro
                    </span>
                    <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm btn-cobrar-atencion"
                            data-bs-toggle="modal" data-bs-target="#modalCobrarAtencion"
                            data-nro-turno="@t.NroTurno">
                        <i class="bi bi-cash-coin me-1"></i> Cobrar
                    </button>
                    break;
                case "FINALIZADO":
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i> Atención Finalizada
                    </span>
                    break;
            }
        </div>
    </div>
}

<!-- MODAL REGISTRAR ATENCIÓN ODONTOLÓGICA -->
<div class="modal fade" id="modalRegistrarAtencion" tabindex="-1" aria-labelledby="modalRegistrarAtencionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="modalRegistrarAtencionLabel">
                    <i class="bi bi-journal-plus me-2"></i>Registrar Atención y Cargar Historia Clínica
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form asp-controller="Odontologo" asp-action="RegistrarAtencionDelDia" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="atencionNroTurno" name="nroTurno" value="" />

                    <div class="bg-light p-3 rounded-3 mb-4 border d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold text-dark mb-0" id="displayPacienteNombre">-</h6>
                        </div>
                        <span class="badge bg-primary px-3 py-2 rounded-pill">Presente</span>
                    </div>

                    <!-- Paso 1: el sistema muestra el número de historia clínica, la fecha de
                         creación y las atenciones previas ANTES de habilitar el resto del
                         formulario. -->
                    <div id="atencionCargando" class="text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Consultando la historia clínica del paciente...
                    </div>

                    <div id="atencionError" class="alert alert-danger d-none" role="alert"></div>

                    <div id="atencionDatosHC" class="d-none">
                        <div class="bg-light p-3 rounded-3 mb-3 border">
                            <p class="fw-semibold text-dark mb-2">
                                Historia Clínica N° <span id="displayNroHC">-</span>
                                <span class="text-muted fw-normal">(creada el <span id="displayFechaCreacionHC">-</span>)</span>
                            </p>
                            <p class="text-muted small fw-semibold mb-1">Atenciones previas:</p>
                            <ul class="small mb-0" id="listaAtencionesPrevias"></ul>
                        </div>
                    </div>

                    <div id="atencionFormFields" class="d-none">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Hora de Inicio</label>
                                <input type="datetime-local" class="form-control" name="fechaHoraInicio" id="atencionFechaInicio" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Hora de Fin</label>
                                <input type="datetime-local" class="form-control" name="fechaHoraFin" id="atencionFechaFin" required />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">Observaciones Clínicas</label>
                                <textarea class="form-control" name="observaciones" rows="3" placeholder="Detallá el diagnóstico, los procedimientos aplicados, piezas tratadas e indicaciones..." required></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark d-block mb-2">Insumos Utilizados</label>
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr class="text-muted small">
                                                <th>Insumo</th>
                                                <th>Costo Unitario</th>
                                                <th>Stock</th>
                                                <th style="width:110px;">Cantidad</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (ViewBag.Insumos != null)
                                            {
                                                foreach (var insumo in (IEnumerable<DTOs.InsumoDisponibleDTO>)ViewBag.Insumos)
                                                {
                                                    <tr>
                                                        <td>@insumo.Nombre</td>
                                                        <td>$@insumo.CostoUnitario.ToString("N0")</td>
                                                        <td>@insumo.StockDisponible</td>
                                                        <td>
                                                            <input type="hidden" name="insumoIds" value="@insumo.IdInsumo" />
                                                            <input type="number" class="form-control form-control-sm" name="cantidades" min="0" max="@insumo.StockDisponible" value="0" />
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="alert alert-info small mb-0">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Al confirmar, el turno pasa a <strong>"Atención Registrada"</strong> y se calcula el monto total. Queda pendiente que el responsable de la clínica procese el cobro.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-end gap-2 p-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm" id="btnGuardarAtencion" disabled>
                        <i class="bi bi-check-circle me-1"></i> Guardar en Historia Clínica
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL COBRAR ATENCIÓN -->
<div class="modal fade" id="modalCobrarAtencion" tabindex="-1" aria-labelledby="modalCobrarAtencionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="modalCobrarAtencionLabel">
                    <i class="bi bi-cash-coin me-2"></i>Cobrar Atención
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Paso 5: el sistema muestra el monto a pagar según la modalidad, en
                     respuesta a que el responsable indica que va a proceder con el cobro. -->
                <div id="cobroCargando" class="text-center text-muted py-4">
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Consultando el monto a pagar...
                </div>

                <div id="cobroError" class="alert alert-danger d-none" role="alert"></div>

                <div id="cobroContenido" class="d-none">
                    <div class="bg-light p-3 rounded-3 mb-4 border d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold text-dark mb-0" id="displayPacienteNombreCobro">-</h6>
                        <span class="badge bg-success px-3 py-2 rounded-pill fs-6">Total: $<span id="displayMontoTotal">0</span></span>
                    </div>

                    <form id="formCobroParticular" asp-controller="Odontologo" asp-action="RegistrarCobroParticular" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="nroTurno" id="cobroParticularNroTurno" value="" />
                        <label class="form-label fw-semibold text-dark">Monto Abonado</label>
                        <input type="number" step="0.01" min="0" class="form-control mb-3" name="monto" id="montoAbonadoInput" required />
                        <label class="form-label fw-semibold text-dark">Método de Pago</label>
                        <select class="form-select mb-3" name="tipoMetodoPago" required>
                            <option value="EFECTIVO">Efectivo</option>
                            <option value="TARJETA_DEBITO">Tarjeta de Débito</option>
                            <option value="TARJETA_CREDITO">Tarjeta de Crédito</option>
                            <option value="TRANSFERENCIA">Transferencia</option>
                        </select>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100">
                            <i class="bi bi-check-circle me-1"></i> Confirmar Cobro Particular
                        </button>
                    </form>

                    <form id="formCobroObraSocial" asp-controller="Odontologo" asp-action="RegistrarCobroObraSocial" method="post" style="display:none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="nroTurno" id="cobroOSNroTurno" value="" />
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Aporte del Paciente</label>
                                <input type="number" step="0.01" min="0" class="form-control" name="aportePaciente" id="aportePacienteInput" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Aporte de la Obra Social</label>
                                <input type="number" step="0.01" min="0" class="form-control" name="aporteObraSocial" id="aporteObraSocialInput" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">Método de Pago (aporte del paciente)</label>
                                <select class="form-select" name="tipoMetodoPago" required>
                                    <option value="EFECTIVO">Efectivo</option>
                                    <option value="TARJETA_DEBITO">Tarjeta de Débito</option>
                                    <option value="TARJETA_CREDITO">Tarjeta de Crédito</option>
                                    <option value="TRANSFERENCIA">Transferencia</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="alert alert-info small mb-0">
                                    <i class="bi bi-info-circle me-1"></i> La suma de ambos aportes debe ser igual al monto total.
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100">
                            <i class="bi bi-check-circle me-1"></i> Confirmar Cobro con Obra Social
                        </button>
                    </form>

                    <hr class="my-4" />

                    <form asp-controller="Odontologo" asp-action="RegistrarFaltaDePago" method="post"
                          onsubmit="return confirm('El paciente quedará inhabilitado hasta que regularice la deuda. ¿Confirmás que no se realizó el pago?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="nroTurno" id="faltaPagoNroTurno" value="" />
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-semibold w-100">
                            <i class="bi bi-exclamation-triangle me-1"></i> Registrar Falta de Pago
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toLocalInput(d) {
            var pad = function (n) { return n < 10 ? '0' + n : n; };
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        document.querySelectorAll('.btn-iniciar-atencion').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var nroTurno = btn.dataset.nroTurno;
                document.getElementById('atencionNroTurno').value = nroTurno;
                document.getElementById('displayPacienteNombre').innerText = btn.dataset.nombrePaciente;

                // Estado inicial: mostrando "cargando", todo lo demás oculto y el botón de
                // guardar deshabilitado hasta que el paso 1 confirme los datos.
                document.getElementById('atencionCargando').classList.remove('d-none');
                document.getElementById('atencionError').classList.add('d-none');
                document.getElementById('atencionDatosHC').classList.add('d-none');
                document.getElementById('atencionFormFields').classList.add('d-none');
                document.getElementById('btnGuardarAtencion').disabled = true;

                // CUU03, paso 1: "El sistema muestra el número de historia clínica, la fecha de
                // creación y las atenciones odontológicas previas del paciente, y habilita el
                // formulario de carga de datos de la consulta."
                fetch('/Odontologo/DatosParaAtencion?nroTurno=' + encodeURIComponent(nroTurno))
                    .then(function (resp) { return resp.json(); })
                    .then(function (data) {
                        document.getElementById('atencionCargando').classList.add('d-none');

                        if (data.resultado !== 0) {
                            document.getElementById('atencionError').textContent = data.mensaje;
                            document.getElementById('atencionError').classList.remove('d-none');
                            return;
                        }

                        document.getElementById('displayNroHC').innerText = data.nroHC;
                        document.getElementById('displayFechaCreacionHC').innerText = new Date(data.fechaCreacionHC).toLocaleDateString();

                        var lista = document.getElementById('listaAtencionesPrevias');
                        lista.innerHTML = '';
                        if (!data.atencionesPrevias || data.atencionesPrevias.length === 0) {
                            lista.innerHTML = '<li class="text-muted">Sin atenciones previas registradas.</li>';
                        } else {
                            data.atencionesPrevias.forEach(function (a) {
                                var li = document.createElement('li');
                                li.textContent = new Date(a.fechaHoraInicio).toLocaleDateString() + ' — ' + a.observaciones;
                                lista.appendChild(li);
                            });
                        }

                        document.getElementById('atencionDatosHC').classList.remove('d-none');
                        document.getElementById('atencionFormFields').classList.remove('d-none');
                        document.getElementById('btnGuardarAtencion').disabled = false;

                        var inicio = new Date();
                        var fin = new Date(inicio.getTime() + 15 * 60000);
                        document.getElementById('atencionFechaInicio').value = toLocalInput(inicio);
                        document.getElementById('atencionFechaFin').value = toLocalInput(fin);
                    })
                    .catch(function () {
                        document.getElementById('atencionCargando').classList.add('d-none');
                        document.getElementById('atencionError').textContent = 'No se pudo consultar la historia clínica del paciente. Intentá de nuevo.';
                        document.getElementById('atencionError').classList.remove('d-none');
                    });
            });
        });

        document.querySelectorAll('.btn-cobrar-atencion').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var nroTurno = btn.dataset.nroTurno;

                document.getElementById('cobroParticularNroTurno').value = nroTurno;
                document.getElementById('cobroOSNroTurno').value = nroTurno;
                document.getElementById('faltaPagoNroTurno').value = nroTurno;

                document.getElementById('cobroCargando').classList.remove('d-none');
                document.getElementById('cobroError').classList.add('d-none');
                document.getElementById('cobroContenido').classList.add('d-none');

                // CUU03, paso 5: "El responsable de la clínica indica al sistema que se
                // procederá al cobro. El sistema muestra el monto total a pagar según la
                // modalidad de pago del paciente."
                fetch('/Odontologo/DatosParaCobro?nroTurno=' + encodeURIComponent(nroTurno))
                    .then(function (resp) { return resp.json(); })
                    .then(function (data) {
                        document.getElementById('cobroCargando').classList.add('d-none');

                        if (data.resultado !== 0) {
                            document.getElementById('cobroError').textContent = data.mensaje;
                            document.getElementById('cobroError').classList.remove('d-none');
                            return;
                        }

                        var esObraSocial = data.modalidadPago === 'Obra Social';

                        document.getElementById('displayPacienteNombreCobro').innerText = data.nombrePaciente;
                        document.getElementById('displayMontoTotal').innerText = data.montoTotal.toLocaleString('es-AR');

                        document.getElementById('formCobroParticular').style.display = esObraSocial ? 'none' : 'block';
                        document.getElementById('formCobroObraSocial').style.display = esObraSocial ? 'block' : 'none';

                        document.getElementById('montoAbonadoInput').value = data.montoTotal;
                        document.getElementById('aportePacienteInput').value = '';
                        document.getElementById('aporteObraSocialInput').value = '';

                        document.getElementById('cobroContenido').classList.remove('d-none');
                    })
                    .catch(function () {
                        document.getElementById('cobroCargando').classList.add('d-none');
                        document.getElementById('cobroError').textContent = 'No se pudo consultar el monto a pagar. Intentá de nuevo.';
                        document.getElementById('cobroError').classList.remove('d-none');
                    });
            });
        });
    </script>
}
