@model Frontend.MVC.Models.PanelResponsableViewModel
@{
    ViewData["Title"] = "Panel Principal - Clínica Dental Rosario";
    ViewData["ActiveTab"] = "PanelPrincipal";
    Layout = "_LayoutResponsable";

    var nombre = User.FindFirst("NombreCompleto")?.Value ?? "Responsable";
}

@section Styles {
    <style>
        .dashboard-card {
            background: #ffffff;
            border: 1px solid #eaeaea;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
            transition: all 0.25s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
        }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            border-color: #cbd5e1;
            color: inherit;
        }

        .card-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            margin-bottom: 14px;
            transition: all 0.2s;
        }

        .card-1 .card-icon { background: #eff6ff; color: #0d6efd; }
        .card-2 .card-icon { background: #f5f3ff; color: #7c3aed; }
        .card-3 .card-icon { background: #fffbeb; color: #d97706; }

        .dashboard-card:hover .card-icon { transform: scale(1.08); }
    </style>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- BIENVENIDA -->
<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">Hola, @nombre</h2>
    @if (Model.TurnosHoy == 0)
    {
        <p class="text-muted mb-0">Hoy no hay turnos programados en la clínica.</p>
    }
    else
    {
        <p class="text-muted mb-0">Hoy hay <strong class="text-primary">@Model.TurnosHoy @(Model.TurnosHoy == 1 ? "turno programado" : "turnos programados")</strong> en la clínica.</p>
    }
    @if (Model.PendientesDeCobro > 0)
    {
        <p class="mt-2 mb-0">
            <a asp-controller="Responsable" asp-action="TurnosDelDia" class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2 rounded-pill text-decoration-none">
                <i class="bi bi-cash-coin me-1"></i>
                @Model.PendientesDeCobro @(Model.PendientesDeCobro == 1 ? "atención pendiente de cobro" : "atenciones pendientes de cobro")
            </a>
        </p>
    }
</div>

<!-- ACCESOS RÁPIDOS PRINCIPALES -->
<h5 class="fw-bold mb-3 text-dark">Accesos Rápidos</h5>

<div class="row g-3 mb-4">

    <!-- Módulo 1: Turnos del Día (todos los odontólogos) -->
    <div class="col-md-6 col-lg-4">
        <a href="@Url.Action("TurnosDelDia", "Responsable")" class="dashboard-card card-1">
            <div class="card-icon"><i class="bi bi-calendar2-day"></i></div>
            <h6 class="fw-bold mb-1 text-dark">Turnos del Día</h6>
            <p class="text-muted small mb-0 flex-grow-1">Mirá los turnos de hoy de todos los odontólogos y cobrá las atenciones ya registradas.</p>
            <div class="mt-3 text-end"><i class="bi bi-arrow-right text-primary"></i></div>
        </a>
    </div>

    <!-- Módulo 2: Gestión de Turnos -->
    <div class="col-md-6 col-lg-4">
        <a href="@Url.Action("GestionTurnos", "Responsable")" class="dashboard-card card-2">
            <div class="card-icon"><i class="bi bi-calendar3"></i></div>
            <h6 class="fw-bold mb-1 text-dark">Gestión de Turnos</h6>
            <p class="text-muted small mb-0 flex-grow-1">Consultá los turnos, agendá y cancelá o reprogramá en representación del paciente.</p>
            <div class="mt-3 text-end"><i class="bi bi-arrow-right" style="color: #7c3aed;"></i></div>
        </a>
    </div>

    <!-- Módulo 3: Control Asistencias -->
    <div class="col-md-6 col-lg-4">
        <a href="@Url.Action("ControlAsistencias", "Responsable")" class="dashboard-card card-3">
            <div class="card-icon"><i class="bi bi-clipboard2-check"></i></div>
            <h6 class="fw-bold mb-1 text-dark">Control Asistencias</h6>
            <p class="text-muted small mb-0 flex-grow-1">Registrá las llegadas y ausencias de los turnos programados.</p>
            <div class="mt-3 text-end"><i class="bi bi-arrow-right" style="color: #d97706;"></i></div>
        </a>
    </div>

</div>
