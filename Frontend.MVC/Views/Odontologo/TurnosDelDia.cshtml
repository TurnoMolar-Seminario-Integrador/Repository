@{
    ViewData["Title"] = "Turnos del Día - Clínica Dental Rosario";
    Layout = null;

    var nombreDoctor = "Dra. Karina González";
    var especialidad = "Odontología General";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦷</text></svg>">

    <link rel="stylesheet" href="~/css/odontologo-layout.css" />

    <style>
        /* Estilos específicos de la vista Turnos del Día */

        .brand-logo { width: 32px; height: auto; }

        /* Lista de turnos con estilo clínico refinado */
        .turno-row {
            background: #ffffff;
            border: 1px solid #eaeaea;
            border-radius: 12px;
            padding: 18px 22px;
            margin-bottom: 14px;
            border-left: 5px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            transition: all 0.2s;
        }

        .turno-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.05);
        }

        .turno-espera  { border-left-color: #f59e0b; background: #fffdfa; }
        .turno-atendido { border-left-color: #10b981; opacity: 0.85; background: #fbfdfc; }

        .turno-hora {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0d3b66;
            min-width: 95px;
        }
    </style>
</head>
<body>

    <!-- SIDEBAR PROFESIONAL -->
    <div class="sidebar">
        <div class="profile-section">
            <img src="https://ui-avatars.com/api/?name=Karina+Gonzalez&background=0d6efd&color=fff" class="profile-avatar" alt="Avatar Profesional" />
            <div class="profile-info">
                <h6>@nombreDoctor</h6>
                <small>@especialidad</small><br />
                <span class="badge-rol">RESPONSABLE CLÍNICO</span>
            </div>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="@Url.Action("Index", "Odontologo")" class="nav-link">
                    <i class="bi bi-grid-1x2"></i> Panel Principal
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("TurnosDelDia", "Odontologo")" class="nav-link active">
                    <i class="bi bi-calendar2-day"></i> Turnos del Día
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("GestionTurnos", "Odontologo")" class="nav-link">
                    <i class="bi bi-calendar3"></i> Gestión de Turnos
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("ControlAsistencias", "Odontologo")" class="nav-link">
                    <i class="bi bi-clipboard2-check"></i> Control de Asistencias
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("GestionAtenciones", "Odontologo")" class="nav-link">
                    <i class="bi bi-file-earmark-medical"></i> Gestión Atenciones
                </a>
            </li>
            <li class="nav-item" style="margin-top: auto;">
                <a href="#" class="nav-link text-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCerrarSesion">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            </li>
        </ul>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-content">
        <div class="top-header">
            <h5 class="brand-title">
                <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" class="brand-logo" />
                Clínica Dental Rosario <span class="text-muted fw-normal fs-6 ms-2">| Portal Profesional</span>
            </h5>
            <div class="d-flex gap-2">
                <span class="badge bg-white text-dark border p-2 shadow-sm rounded-pill">
                    <i class="bi bi-calendar3 text-primary me-1"></i> Agenda de Hoy: Viernes
                </span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Agenda de Hoy</h2>
                <p class="text-muted mb-0">Listado de pacientes citados y estado de atención en tiempo real.</p>
            </div>
            <button class="btn btn-outline-primary rounded-pill fw-semibold shadow-sm" onclick="window.print();">
                <i class="bi bi-printer me-2"></i>Imprimir Agenda
            </button>
        </div>

        <!-- Alerta de Éxito al guardar historia clínica -->
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Paciente 1: En Espera -->
        <div class="turno-row turno-espera">
            <div class="d-flex align-items-center gap-4">
                <div class="turno-hora">09:30 AM</div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Manuel Fernández</h6>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-card-text me-1 text-primary"></i> Control General • OSDE 310 (HC #10042)
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2 rounded-pill">
                    <i class="bi bi-person-check me-1"></i> En Sala de Espera
                </span>
                <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalRegistrarAtencion" onclick="prepararAtencion('Manuel Fernández', '10042', 'Control General', 'OSDE 310');">
                    <i class="bi bi-journal-plus me-1"></i> Iniciar Atención
                </button>
            </div>
        </div>

        <!-- Paciente 2: Por llegar -->
        <div class="turno-row">
            <div class="d-flex align-items-center gap-4">
                <div class="turno-hora text-secondary">10:30 AM</div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Lucía Martínez</h6>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-card-text me-1 text-primary"></i> Ortodoncia (Ajuste mensual) • Particular (HC #10058)
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                    <i class="bi bi-clock me-1"></i> Pendiente Admisión
                </span>
                <button class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" disabled>
                    Esperando Llegada
                </button>
            </div>
        </div>

        <!-- Paciente 3: Atendido -->
        <div class="turno-row turno-atendido">
            <div class="d-flex align-items-center gap-4">
                <div class="turno-hora text-muted">08:00 AM</div>
                <div>
                    <h6 class="fw-bold mb-1 text-muted">Carlos Silva</h6>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-check2-all me-1 text-success"></i> Extracción Simple • IAPOS (HC #09812)
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                    <i class="bi bi-check-circle-fill me-1"></i> Atención Finalizada
                </span>
                <button class="btn btn-outline-primary rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#modalVerFichaMedica">
                    <i class="bi bi-file-earmark-medical me-1"></i> Ver Ficha Médica
                </button>
            </div>
        </div>

    </div>

    <!-- MODAL REGISTRAR ATENCIÓN ODONTOLÓGICA (CARGAR HISTORIA CLÍNICA) -->
    <div class="modal fade" id="modalRegistrarAtencion" tabindex="-1" aria-labelledby="modalRegistrarAtencionLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white border-0 py-3">
                    <h5 class="modal-title fw-bold" id="modalRegistrarAtencionLabel">
                        <i class="bi bi-journal-plus me-2"></i>Registrar Atención y Cargar Historia Clínica
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-controller="Odontologo" asp-action="GuardarAtencion" method="post">
                    <div class="modal-body p-4">
                        <input type="hidden" id="atencionPacienteNombre" name="pacienteNombre" value="Manuel Fernández" />
                        <input type="hidden" id="atencionNumeroHc" name="numeroHc" value="10042" />

                        <!-- Resumen del Paciente -->
                        <div class="bg-light p-3 rounded-3 mb-4 border d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold text-dark mb-0" id="displayPacienteNombre">Manuel Fernández</h6>
                                <small class="text-muted">Historia Clínica: <strong id="displayNumeroHc" class="text-primary">#10042</strong> | Cobertura: <span id="displayCobertura">OSDE 310</span></small>
                            </div>
                            <span class="badge bg-primary px-3 py-2 rounded-pill">Atención en Curso</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Tipo de Tratamiento Realizado</label>
                                <select class="form-select" name="tratamiento" required>
                                    <option value="Consulta General">Consulta General / Diagnóstico</option>
                                    <option value="Limpieza y Profilaxis">Limpieza y Profilaxis Ultrasonido</option>
                                    <option value="Restauración Estética">Restauración / Obstrucción con Resina</option>
                                    <option value="Endodoncia">Endodoncia / Tratamiento de Conducto</option>
                                    <option value="Extracción Simple">Extracción / Exodoncia Simple</option>
                                    <option value="Ortodoncia">Ajuste / Control de Ortodoncia</option>
                                    <option value="Implante Dental">Implante / Cirugía Implantológica</option>
                                    <option value="Prótesis Dental">Prótesis / Impresión Dental</option>
                                    <option value="Blanqueamiento">Blanqueamiento Dental</option>
                                    <option value="Control Postoperatorio">Control Postoperatorio</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-dark">Valoración del Estado Bucal</label>
                                <select class="form-select" name="valoracion">
                                    <option value="Excelente">Excelente estado de salud bucodental</option>
                                    <option value="Buena" selected>Buena higiene, control de rutina</option>
                                    <option value="Regular">Regular (requiere nuevos tratamientos)</option>
                                    <option value="Mala">Prioritario / Requiere tratamiento urgente</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">Diagnóstico Odontológico</label>
                                <textarea class="form-control" name="diagnostico" rows="2" placeholder="Describí el diagnóstico o estado dental del paciente..." required>Caries oclusal incipiente en pieza 1.6 sin afectación pulpar.</textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark">Evolución Clínica y Observaciones</label>
                                <textarea class="form-control" name="observaciones" rows="3" placeholder="Detallá los procedimientos aplicados, piezas tratadas e indicaciones..." required>Se realizó limpieza superficial y obturación estética con resina fotocurable 3M A2 en pieza 1.6. Se indican controles semestrales y correcto cepillado.</textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold text-dark mb-2">Insumos Utilizados en la Sesión</label>
                                <div class="p-3 border rounded-3 bg-light">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="insumos" value="Anestesia Tubaria" id="ins1" checked>
                                                <label class="form-check-label small" for="ins1">Anestesia Tubaria (1 tubo)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="insumos" value="Resina Fotocurable A2" id="ins2" checked>
                                                <label class="form-check-label small" for="ins2">Resina Fotocurable A2</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="insumos" value="Ácido Grabador + Adhesivo" id="ins3" checked>
                                                <label class="form-check-label small" for="ins3">Ácido Grabador + Adhesivo</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="insumos" value="Gasa Estéril" id="ins4">
                                                <label class="form-check-label small" for="ins4">Gasa Estéril (Paquete)</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="insumos" value="Dique de Goma Aislante" id="ins5">
                                                <label class="form-check-label small" for="ins5">Dique de Goma Aislante</label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="insumos" value="Kit Profilaxis" id="ins6">
                                                <label class="form-check-label small" for="ins6">Pasta Profiláctica + Cepillo</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 justify-content-end gap-2 p-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Guardar en Historia Clínica y Finalizar Turno
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL VER FICHA MÉDICA / HISTORIA CLÍNICA -->
    <div class="modal fade" id="modalVerFichaMedica" tabindex="-1" aria-labelledby="modalVerFichaMedicaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-info text-white border-0 py-3">
                    <h5 class="modal-title fw-bold" id="modalVerFichaMedicaLabel">
                        <i class="bi bi-file-earmark-medical me-2"></i>Historia Clínica del Paciente
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="bg-light p-3 rounded-3 mb-4 border d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Carlos Silva</h5>
                            <small class="text-muted">HC <strong class="text-info">#09812</strong> | DNI: 32.145.890 | Cobertura: <strong>IAPOS</strong></small>
                        </div>
                        <span class="badge bg-success px-3 py-2 rounded-pill">Historia Clínica Activa</span>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-clock-history me-2 text-primary"></i>Historial de Atenciones Registradas
                    </h6>

                    <!-- Entrada 1 -->
                    <div class="p-3 border-start border-4 border-success bg-light rounded-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-dark">Extracción Simple (Pieza 3.8)</strong>
                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> Hoy, 08:00 AM</small>
                        </div>
                        <p class="small text-muted mb-1"><strong>Diagnóstico:</strong> Caries penetrante irreversible con indicación exodóncica.</p>
                        <p class="small text-muted mb-1"><strong>Observaciones:</strong> Exodoncia completa sin complicaciones. Se indica analgésico y hielo local.</p>
                        <div class="small text-primary"><strong>Insumos:</strong> Anestesia Tubaria (x2), Sutura 3-0, Gasa estéril.</div>
                    </div>

                    <!-- Entrada 2 -->
                    <div class="p-3 border-start border-4 border-primary bg-light rounded-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-dark">Limpieza Profiláctica Anual</strong>
                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i> 15 de Enero 2025</small>
                        </div>
                        <p class="small text-muted mb-1"><strong>Diagnóstico:</strong> Acumulación leve de tártaro inferior.</p>
                        <p class="small text-muted mb-0"><strong>Observaciones:</strong> Se realizó limpieza con ultrasonido sin imprevistos.</p>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-end p-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar Ficha</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL CONFIRMACIÓN DE CERRAR SESIÓN -->
    <div class="modal fade" id="modalCerrarSesion" tabindex="-1" aria-labelledby="modalCerrarSesionLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header text-white border-0 py-3 px-4" style="background: linear-gradient(135deg, #0d3b66 0%, #1d6fa5 100%);">
                    <h5 class="modal-title fw-bold fs-6 d-flex align-items-center gap-2" id="modalCerrarSesionLabel">
                        <i class="bi bi-door-open-fill opacity-75"></i> Confirmación de Salida
                    </h5>
                    <button type="button" class="btn-close btn-close-white opacity-75" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 72px; height: 72px; background-color: #eef6ff; color: #0d3b66;">
                            <i class="bi bi-box-arrow-right fs-1" style="margin-left: 3px;"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">¿Querés cerrar sesión?</h5>
                    <p class="text-muted small mb-0 px-2">
                        Al salir, finalizará tu sesión como <strong>Dra. Karina González</strong> y serás redirigido a la pantalla de ingreso.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-center gap-2 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold border shadow-sm" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </button>
                    <a href="@Url.Action("Login", "Home")" class="btn rounded-pill px-4 fw-bold shadow-sm text-white" style="background: linear-gradient(135deg, #0d3b66, #0d6efd); border: none;">
                        <i class="bi bi-box-arrow-right me-1"></i> Sí, Cerrar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function prepararAtencion(nombre, hc, tratamiento, cobertura) {
            document.getElementById('atencionPacienteNombre').value = nombre;
            document.getElementById('atencionNumeroHc').value = hc;
            document.getElementById('displayPacienteNombre').innerText = nombre;
            document.getElementById('displayNumeroHc').innerText = '#' + hc;
            document.getElementById('displayCobertura').innerText = cobertura;
        }
    </script>
</body>
</html>
