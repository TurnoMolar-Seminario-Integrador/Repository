@model Frontend.MVC.Models.MetodosPagoViewModel
@using Domain.Model
@{
    ViewData["Title"] = "Métodos de Pago - Clínica Dental Rosario";
    ViewData["ActiveTab"] = "MetodosDePago";
    Layout = "_LayoutPaciente";

    var deudaActual = Model.SaldoPendiente;
    var estaInhabilitado = Model.EstaInhabilitado;

    // Sin el turno que originó la deuda no hay dónde registrar el pago (CUF10, paso 3): el detalle lo informa.
    var puedePagar = deudaActual > 0 && (Model.DeudaDetalle == null || Model.DeudaDetalle.NroTurno.HasValue);
}

@section Styles {
    <style>
        .balance-card {
            background: linear-gradient(135deg, #0d3b66, #1d6fa5);
            color: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(13,59,102,0.2);
        }

        .balance-card.pagado {
            background: linear-gradient(135deg, #0f5132, #198754);
        }

        .payment-method-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s;
        }

        .payment-method-card:hover {
            border-color: #bfdbfe;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.06);
        }

        .tarjeta-radio:checked + .payment-method-card {
            border-color: #2563eb;
            background-color: #eff6ff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
        }
    </style>
}

<!-- Alerta de Éxito al pagar -->
@if (TempData["PagoExitoso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 bg-success text-white mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["PagoExitoso"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeInfo"] != null)
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2"></i> @TempData["MensajeInfo"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4">
    <h2 class="fw-bold text-dark mb-1">Estado de Cuenta y Pagos</h2>
    <p class="text-muted small">Administrá tus saldos pendientes y revisá tu historial de pagos registrados en el sistema.</p>
</div>

<div class="row">
    <!-- Columna Izquierda: Estado de Cuenta -->
    <div class="col-lg-5 mb-4">

        @if (deudaActual > 0)
        {
            <div class="alert alert-danger border-0 d-flex justify-content-between align-items-center rounded-top mb-0" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0;">
                <span class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Atención Requerida</span>
                <span class="badge bg-white text-danger">INHABILITADO</span>
            </div>
        }

        <div class="balance-card @(deudaActual == 0 ? "pagado" : "")" style="@(deudaActual > 0 ? "border-top-left-radius: 0; border-top-right-radius: 0;" : "")">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="opacity-75">Saldo Pendiente de Pago</span>
                <i class="bi bi-receipt fs-4"></i>
            </div>
            <h1 class="fw-bold mb-1 text-center py-3">$ @deudaActual.ToString("N2")</h1>

            @if (deudaActual > 0)
            {
                <p class="small text-center opacity-75 mb-4">Poseés un saldo pendiente por tratamientos o cancelaciones. Por favor, regularizá tu situación para poder agendar nuevos turnos.</p>
                <button class="btn btn-light w-100 fw-bold text-danger rounded-pill py-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalPagarDeuda">
                    <i class="bi bi-credit-card me-2"></i> Pagar Deuda Ahora
                </button>
            }
            else
            {
                <p class="text-center opacity-75 mb-0"><i class="bi bi-check-circle-fill me-2"></i>Tu cuenta está completamente al día. Estado: HABILITADO.</p>
            }
        </div>
    </div>

    <!-- Columna Derecha: Historial de Pagos y Métodos -->
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Historial de Pagos Realizados</h5>
            <span class="badge bg-primary rounded-pill">@Model.HistorialPagos.Count registro(s)</span>
        </div>

        @if (Model.HistorialPagos.Any())
        {
            @foreach (var pago in Model.HistorialPagos)
            {
                <div class="payment-method-card mb-3 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-light p-2 rounded text-success"><i class="bi bi-check2-circle fs-4"></i></div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">@Frontend.MVC.Models.MetodosPagoViewModel.DescribirPago(pago)</h6>
                            <small class="text-muted">@pago.FechaYHoraPago.ToString("dd/MM/yyyy HH:mm") hs • Método: @MetodosPago.Etiqueta(pago.TipoMetodoPago)</small>
                            @if (pago.AporteObraSocial.GetValueOrDefault() > 0m)
                            {
                                @* Aporte de la obra social (CUU03 alt 6.a): el paciente puso solo su parte. *@
                                <small class="d-block text-muted">
                                    Tu aporte: $@((pago.AportePaciente ?? 0m).ToString("N2")) • Obra social@(pago.ObraSocial != null ? $" ({pago.ObraSocial.NombreOS})" : ""): $@pago.AporteObraSocial!.Value.ToString("N2")
                                </small>
                            }
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-dark">$@pago.Monto.ToString("N2")</div>
                        <span class="badge bg-success bg-opacity-10 text-success fw-bold">PAGADO</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bg-white border rounded-4 p-4 text-center text-muted small" id="sinPagosRegistrados">
                <i class="bi bi-receipt me-1"></i> Todavía no tenés pagos registrados. Los recibos de tus próximos pagos se registrarán aquí automáticamente.
            </div>
        }
    </div>
</div>

<!-- ==========================================
     MODAL: PAGAR DEUDA (CUF10)
     ========================================== -->
<div class="modal fade" id="modalPagarDeuda" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-light border-0 py-3 px-4">
                <h5 class="modal-title fw-bold"><i class="bi bi-wallet2 me-2 text-primary"></i>Abonar Saldo Pendiente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Home" asp-action="PagarDeuda" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">

                    @* Paso 1: saldo de deuda y detalle del turno que la originó (nroTurno, fecha y motivo). *@
                    @if (Model.DeudaDetalle != null)
                    {
                        <partial name="_DetalleDeuda" model="Model.DeudaDetalle" />
                    }
                    else
                    {
                        <div class="text-center mb-2">
                            <span class="text-muted small text-uppercase fw-bold d-block mb-1">Monto Total a Regularizar</span>
                            <h2 class="fw-bold text-dark">$ @deudaActual.ToString("N2")</h2>
                        </div>
                    }

                    @if (puedePagar)
                    {
                        @* Pasos 2 y 3: se abona el total de la deuda con el método elegido. *@
                        <label class="form-label fw-bold mt-3 mb-2">Método de pago</label>
                        <partial name="_SelectMetodoPago" />
                        <div class="form-text">Se registra el pago del total de la deuda y tu cuenta queda Habilitada.</div>
                    }
                </div>
                <div class="modal-footer bg-light border-0 justify-content-between p-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    @if (puedePagar)
                    {
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-lock-fill me-1"></i> Confirmar y Pagar
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>