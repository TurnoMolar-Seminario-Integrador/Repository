@{
    ViewData["Title"] = "Métodos de Pago - Clínica Dental Rosario";
    Layout = null;

    var nombrePaciente = ViewData["NombrePaciente"] ?? "Manuel Fernández";
    var idPaciente = ViewData["IdPaciente"] ?? "10042";

    // Lógica visual simulada: Si no hay mensaje de pago exitoso, asumimos que debe plata.
    bool tieneDeuda = TempData["PagoExitoso"] == null;
    var estadoPaciente = tieneDeuda ? "INHABILITADO" : "HABILITADO";
    var badgeClass = tieneDeuda ? "bg-danger text-white" : "bg-success text-white";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            overflow-x: hidden;
        }

        /* Sidebar (Mismos estilos) */
        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #ffffff;
            border-right: 1px solid #e5e5e5;
            display: flex;
            flex-direction: column;
            padding: 20px;
            z-index: 100;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 20px;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 20px;
        }

        .profile-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
        }

        .profile-info h6 {
            font-size: 0.95rem;
            font-weight: bold;
            margin: 0;
            color: #212529;
        }

        .profile-info small {
            font-size: 0.78rem;
            color: #6c757d;
        }

        .badge-estado {
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: bold;
            display: inline-block;
            margin-top: 3px;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }

        .nav-item {
            margin-bottom: 5px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            color: #495057;
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

            .nav-link:hover {
                background-color: #f1f3f5;
                color: #0d6efd;
            }

            .nav-link.active {
                background-color: #0d6efd;
                color: #ffffff;
            }

        /* Contenido Principal */
        .main-content {
            margin-left: 260px;
            padding: 30px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .brand-title {
            color: #0d3b66;
            font-weight: bold;
            font-size: 1.3rem;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo {
            width: 32px;
            height: auto;
        }

        /* Tarjetas de Deuda / Pago */
        .debt-card {
            border-radius: 12px;
            border: none;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            overflow: hidden;
        }

        .debt-card-header {
            padding: 20px;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .debt-card-body {
            padding: 25px;
            background: #ffffff;
        }

        .credit-card-mock {
            background: linear-gradient(135deg, #1e1e1e, #3a3a3a);
            color: white;
            border-radius: 10px;
            padding: 20px;
            position: relative;
            margin-bottom: 20px;
        }

        /* Tabla de Pagos */
        .table-custom {
            background-color: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            border: 1px solid #eaeaea;
        }

            .table-custom th {
                background-color: #f8f9fa;
                color: #495057;
                font-weight: 600;
                border-bottom: 2px solid #e9ecef;
                padding: 15px;
            }

            .table-custom td {
                padding: 15px;
                vertical-align: middle;
                color: #333;
            }
    </style>
</head>
<body>

    <!-- SIDEBAR DE NAVEGACIÓN -->
    <div class="sidebar">
        <div class="profile-section">
            <img src="https://ui-avatars.com/api/?name=@nombrePaciente&background=0d6efd&color=fff" alt="Perfil" class="profile-avatar" />
            <div class="profile-info">
                <h6>@nombrePaciente</h6>
                <small>ID: #@idPaciente</small><br>
                <!-- El estado cambia dinámicamente según la deuda -->
                <span class="badge-estado @badgeClass">ESTADO: @estadoPaciente</span>
            </div>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="#" class="nav-link"><i class="bi bi-calendar3"></i> Mis Turnos</a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("HistorialClinico", "Home")" class="nav-link"><i class="bi bi-file-medical"></i> Historial Clínico</a>
            </li>

            <!-- PESTAÑA ACTIVA: MÉTODOS DE PAGO -->
            <li class="nav-item">
                <a href="@Url.Action("MetodosDePago", "Home")" class="nav-link active"><i class="bi bi-wallet2"></i> Métodos de Pago</a>
            </li>

            <li class="nav-item">
                <a href="#" class="nav-link"><i class="bi bi-shield-check"></i> Seguros/Obras Sociales</a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("Index", "Home")" class="nav-link"><i class="bi bi-house-door"></i> Inicio</a>
            </li>
            <li class="nav-item" style="margin-top: auto;">
                <a href="#" class="nav-link"><i class="bi bi-gear"></i> Configuración</a>
            </li>
        </ul>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-content">

        <div class="top-header">
            <h5 class="brand-title">
                <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" class="brand-logo" />
                Clínica Dental Rosario
            </h5>
            <button class="btn btn-light rounded-circle shadow-sm" style="width: 40px; height: 40px;">
                <i class="bi bi-bell"></i>
            </button>
        </div>

        <div class="mb-4">
            <h2 class="fw-bold text-dark mb-1">Estado de Cuenta y Pagos</h2>
            <p class="text-muted small">Administrá tus saldos pendientes y revisá tu historial de facturación.</p>
        </div>

        @if (TempData["PagoExitoso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["PagoExitoso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row mb-5">
            <!-- Columna Izquierda: Estado de Deuda -->
            <div class="col-lg-6">
                @if (tieneDeuda)
                {
                    <div class="card debt-card">
                        <div class="debt-card-header bg-danger text-white d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-exclamation-triangle-fill me-2"></i> Atención Requerida</span>
                            <span class="badge bg-white text-danger">INHABILITADO</span>
                        </div>
                        <div class="debt-card-body text-center">
                            <h5 class="text-muted mb-2">Saldo Pendiente</h5>
                            <h2 class="fw-bold text-danger mb-4">$ 15.500,00</h2>
                            <p class="small text-muted mb-4">Poseés una deuda por tratamientos anteriores. Por favor, regularizá tu saldo para poder agendar nuevos turnos.</p>

                            <!-- Formulario que simula el pago -->
                            <form asp-controller="Home" asp-action="PagarDeuda" method="post">
                                <button type="submit" class="btn btn-danger w-100 fw-bold py-2 rounded-pill shadow-sm">
                                    <i class="bi bi-credit-card me-2"></i> Pagar Ahora
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card debt-card">
                        <div class="debt-card-header bg-success text-white d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-check-circle-fill me-2"></i> Cuenta al día</span>
                            <span class="badge bg-white text-success">HABILITADO</span>
                        </div>
                        <div class="debt-card-body text-center">
                            <div class="display-1 text-success mb-3"><i class="bi bi-emoji-smile"></i></div>
                            <h5 class="fw-bold text-dark">No registrás deudas pendientes</h5>
                            <p class="small text-muted">Podés reservar turnos con total normalidad desde la pestaña de Inicio.</p>
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-success w-100 fw-bold py-2 rounded-pill mt-2">
                                Ir a reservar turno
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Columna Derecha: Tarjeta Simulada -->
            <div class="col-lg-6">
                <h5 class="fw-bold mb-3">Método de Pago Vinculado</h5>
                <div class="credit-card-mock shadow-sm">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <i class="bi bi-sim" style="font-size: 2rem; color: #ffd700;"></i>
                        <span class="fst-italic fw-bold fs-5">VISA</span>
                    </div>
                    <h4 class="mb-3" style="letter-spacing: 2px;">**** **** **** 4289</h4>
                    <div class="d-flex justify-content-between text-white-50 small">
                        <span>Titular<br /><strong class="text-white">@nombrePaciente.ToString().ToUpper()</strong></span>
                        <span>Vence<br /><strong class="text-white">12/28</strong></span>
                    </div>
                </div>
                <button class="btn btn-outline-secondary w-100 rounded-pill"><i class="bi bi-plus-circle me-2"></i>Agregar nueva tarjeta</button>
            </div>
        </div>

        <!-- Historial de Pagos (Basado en la clase 'Pago') -->
        <h5 class="fw-bold mb-3 mt-2">Historial de Transacciones</h5>
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">Fecha de Pago</th>
                        <th scope="col">Método de Pago</th>
                        <th scope="col">Concepto</th>
                        <th scope="col">Monto</th>
                        <th scope="col">Comprobante</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Si ya no tiene deuda, mostramos el pago recién hecho -->
                    @if (!tieneDeuda)
                    {
                        <tr>
                            <td><i class="bi bi-calendar-check me-2 text-success"></i>Hoy</td>
                            <td>Tarjeta de Crédito (Visa *4289)</td>
                            <td>Cancelación de Saldo Pendiente</td>
                            <td class="fw-bold text-success">$ 15.500,00</td>
                            <td><button class="btn btn-sm btn-light text-primary"><i class="bi bi-download"></i> PDF</button></td>
                        </tr>
                    }
                    <tr>
                        <td><i class="bi bi-calendar-check me-2 text-muted"></i>15 Oct, 2025</td>
                        <td>Obra Social (OSDE)</td>
                        <td>Cobertura Control General</td>
                        <td class="fw-bold text-dark">$ 8.200,00</td>
                        <td><button class="btn btn-sm btn-light text-primary"><i class="bi bi-download"></i> PDF</button></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-calendar-check me-2 text-muted"></i>02 Sep, 2025</td>
                        <td>Tarjeta de Débito</td>
                        <td>Coseguro Extracción 3er Molar</td>
                        <td class="fw-bold text-dark">$ 5.000,00</td>
                        <td><button class="btn btn-sm btn-light text-primary"><i class="bi bi-download"></i> PDF</button></td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>