@{
    ViewData["Title"] = "Turnos del Día - Clínica Dental Rosario";
    Layout = null;

    var nombreDoctor = "Dra. Karina González";
    var especialidad = "Odontología General";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            overflow-x: hidden;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #ffffff;
            border-right: 1px solid #e5e5e5;
            display: flex;
            flex-direction: column;
            padding: 20px;
            z-index: 100;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 20px;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 20px;
        }

        .profile-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #0d6efd;
        }

        .profile-info h6 {
            font-size: 0.92rem;
            font-weight: bold;
            margin: 0;
            color: #212529;
        }

        .profile-info small {
            font-size: 0.76rem;
            color: #6c757d;
        }

        .badge-rol {
            background-color: #e6f0fa;
            color: #004694;
            font-size: 0.65rem;
            padding: 2px 7px;
            border-radius: 4px;
            font-weight: 700;
            display: inline-block;
            margin-top: 4px;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }

        .nav-item {
            margin-bottom: 5px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            color: #495057;
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .nav-link:hover {
            background-color: #f1f3f5;
            color: #0d6efd;
        }

        .nav-link.active {
            background-color: #0d6efd;
            color: #ffffff;
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.2);
        }

        .nav-link.active i {
            color: #ffffff;
        }

        .main-content {
            margin-left: 260px;
            padding: 30px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .brand-title {
            color: #0d3b66;
            font-weight: bold;
            font-size: 1.3rem;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo {
            width: 32px;
            height: auto;
        }

        /* Lista de turnos con estilo clínico refinado */
        .turno-row {
            background: #ffffff;
            border: 1px solid #eaeaea;
            border-radius: 12px;
            padding: 18px 22px;
            margin-bottom: 14px;
            border-left: 5px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            transition: all 0.2s;
        }

        .turno-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.05);
        }

        .turno-espera {
            border-left-color: #f59e0b;
            background: #fffdfa;
        }

        .turno-atendido {
            border-left-color: #10b981;
            opacity: 0.85;
            background: #fbfdfc;
        }

        .turno-hora {
            font-size: 1.15rem;
            font-weight: 700;
            color: #0d3b66;
            min-width: 95px;
        }
    </style>
</head>
<body>

    <!-- SIDEBAR PROFESIONAL -->
    <div class="sidebar">
        <div class="profile-section">
            <img src="https://ui-avatars.com/api/?name=Karina+Gonzalez&background=0d6efd&color=fff" class="profile-avatar" alt="Avatar Profesional" />
            <div class="profile-info">
                <h6>@nombreDoctor</h6>
                <small>@especialidad</small><br />
                <span class="badge-rol">RESPONSABLE CLÍNICO</span>
            </div>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="@Url.Action("Index", "Odontologo")" class="nav-link">
                    <i class="bi bi-grid-1x2"></i> Panel Principal
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("TurnosDelDia", "Odontologo")" class="nav-link active">
                    <i class="bi bi-calendar2-day"></i> Turnos del Día
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="bi bi-calendar3"></i> Gestión de Turnos
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="bi bi-clipboard2-check"></i> Control de Asistencias
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link">
                    <i class="bi bi-file-earmark-medical"></i> Gestión Atenciones
                </a>
            </li>
            <li class="nav-item" style="margin-top: auto;">
                <a href="@Url.Action("Login", "Home")" class="nav-link text-danger fw-semibold">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            </li>
        </ul>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-content">
        <div class="top-header">
            <h5 class="brand-title">
                <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" class="brand-logo" />
                Clínica Dental Rosario <span class="text-muted fw-normal fs-6 ms-2">| Portal Profesional</span>
            </h5>
            <div class="d-flex gap-2">
                <span class="badge bg-white text-dark border p-2 shadow-sm rounded-pill">
                    <i class="bi bi-calendar3 text-primary me-1"></i> Agenda de Hoy: Viernes
                </span>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">Agenda de Hoy</h2>
                <p class="text-muted mb-0">Listado de pacientes citados y estado de atención en tiempo real.</p>
            </div>
            <button class="btn btn-outline-primary rounded-pill fw-semibold shadow-sm" onclick="window.print();">
                <i class="bi bi-printer me-2"></i>Imprimir Agenda
            </button>
        </div>

        <!-- Paciente 1: En Espera -->
        <div class="turno-row turno-espera">
            <div class="d-flex align-items-center gap-4">
                <div class="turno-hora">09:30 AM</div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Manuel Fernández</h6>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-card-text me-1 text-primary"></i> Control General • OSDE 310 (HC #10042)
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2 rounded-pill">
                    <i class="bi bi-person-check me-1"></i> En Sala de Espera
                </span>
                <button class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    Iniciar Atención
                </button>
            </div>
        </div>

        <!-- Paciente 2: Por llegar -->
        <div class="turno-row">
            <div class="d-flex align-items-center gap-4">
                <div class="turno-hora text-secondary">10:30 AM</div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Lucía Martínez</h6>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-card-text me-1 text-primary"></i> Ortodoncia (Ajuste mensual) • Particular (HC #10058)
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                    <i class="bi bi-clock me-1"></i> Pendiente Admisión
                </span>
                <button class="btn btn-outline-secondary rounded-pill px-4 fw-semibold" disabled>
                    Esperando Llegada
                </button>
            </div>
        </div>

        <!-- Paciente 3: Atendido -->
        <div class="turno-row turno-atendido">
            <div class="d-flex align-items-center gap-4">
                <div class="turno-hora text-muted">08:00 AM</div>
                <div>
                    <h6 class="fw-bold mb-1 text-muted">Carlos Silva</h6>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-check2-all me-1 text-success"></i> Extracción Simple • IAPOS (HC #09812)
                    </p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                    <i class="bi bi-check-circle-fill me-1"></i> Atención Finalizada
                </span>
                <button class="btn btn-outline-primary rounded-pill px-3 fw-semibold">
                    Ver Ficha Médica
                </button>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
