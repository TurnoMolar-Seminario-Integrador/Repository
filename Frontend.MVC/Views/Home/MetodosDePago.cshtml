@{
    ViewData["Title"] = "Métodos de Pago - Clínica Dental Rosario";
    Layout = null;
    var nombrePaciente = ViewData["NombrePaciente"] ?? "Manuel Fernández";
    var idPaciente = ViewData["IdPaciente"] ?? "10042";

    // MAGIA VISUAL: Si existe el TempData de éxito (porque acabamos de pagar), la deuda es 0.
    // Si no, simulamos que debe 15.500 pesos.
    decimal deudaActual = TempData["PagoExitoso"] != null ? 0.00m : 15500.00m;

    var estadoPaciente = deudaActual > 0 ? "INHABILITADO" : "HABILITADO";
    var badgeClass = deudaActual > 0 ? "bg-danger text-white" : "badge-habilitado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', sans-serif;
            color: #333;
            overflow-x: hidden;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #ffffff;
            border-right: 1px solid #e5e5e5;
            display: flex;
            flex-direction: column;
            padding: 20px;
            z-index: 100;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 20px;
            border-bottom: 1px solid #f0f0f0;
            margin-bottom: 20px;
        }

        .profile-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
        }

        .profile-info h6 {
            font-size: 0.95rem;
            font-weight: bold;
            margin: 0;
        }

        .profile-info small {
            font-size: 0.78rem;
            color: #6c757d;
        }

        .badge-habilitado {
            background-color: #d1e7dd;
            color: #0f5132;
        }

        .status-badge-global {
            font-size: 0.65rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: bold;
            display: inline-block;
            margin-top: 3px;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            color: #495057;
            text-decoration: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s ease;
            margin-bottom: 5px;
        }

            .nav-link:hover {
                background-color: #f1f3f5;
                color: #0d6efd;
            }

            .nav-link.active {
                background-color: #0d6efd;
                color: #ffffff;
            }

        .main-content {
            margin-left: 260px;
            padding: 30px;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .brand-title {
            color: #0d3b66;
            font-weight: bold;
            font-size: 1.3rem;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo {
            width: 32px;
            height: auto;
        }

        .balance-card {
            background: linear-gradient(135deg, #0d3b66, #1d6fa5);
            color: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 15px rgba(13,59,102,0.2);
        }

            .balance-card.pagado {
                background: linear-gradient(135deg, #0f5132, #198754);
            }

        .payment-method-card {
            background: #fff;
            border: 1px solid #eaeaea;
            border-radius: 12px;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s;
        }

        /* Estilos para que las tarjetas de crédito parezcan seleccionables en el Modal */
        .tarjeta-radio:checked + .payment-method-card {
            border-color: #0d6efd;
            background-color: #f8fbff;
            box-shadow: 0 4px 10px rgba(13,110,253,0.15);
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="profile-section">
            <img src="https://ui-avatars.com/api/?name=@nombrePaciente&background=0d6efd&color=fff" class="profile-avatar" />
            <div class="profile-info">
                <h6>@nombrePaciente</h6>
                <small>ID: #@idPaciente</small><br>
                <span class="status-badge-global @badgeClass">ESTADO: @estadoPaciente</span>
            </div>
        </div>

        <!-- MENÚ GLOBAL 100% FUNCIONAL -->
        <ul class="nav-menu">
            <li><a href="@Url.Action("MisTurnos", "Home")" class="nav-link"><i class="bi bi-calendar3"></i> Mis Turnos</a></li>
            <li><a href="@Url.Action("HistorialClinico", "Home")" class="nav-link"><i class="bi bi-file-medical"></i> Historial Clínico</a></li>
            <li><a href="@Url.Action("MetodosDePago", "Home")" class="nav-link active"><i class="bi bi-wallet2"></i> Métodos de Pago</a></li>
            <li><a href="@Url.Action("Seguros", "Home")" class="nav-link"><i class="bi bi-shield-check"></i> Seguros/Obras Sociales</a></li>
            <li><a href="@Url.Action("Index", "Home")" class="nav-link"><i class="bi bi-house-door"></i> Inicio</a></li>
            <li style="margin-top: auto;"><a href="@Url.Action("Configuracion", "Home")" class="nav-link"><i class="bi bi-gear"></i> Configuración</a></li>
        </ul>
    </div>

    <div class="main-content">
        <div class="top-header">
            <h5 class="brand-title">
                <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" class="brand-logo" /> Clínica Dental Rosario
            </h5>
            <button class="btn btn-light rounded-circle shadow-sm" style="width: 40px; height: 40px;"><i class="bi bi-bell"></i></button>
        </div>

        <!-- Alerta de Éxito al pagar -->
        @if (TempData["PagoExitoso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 bg-success text-white" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["PagoExitoso"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="mb-4">
            <h2 class="fw-bold text-dark mb-1">Estado de Cuenta y Pagos</h2>
            <p class="text-muted small">Administrá tus saldos pendientes y revisá tu historial de facturación.</p>
        </div>

        <div class="row">
            <!-- Columna Izquierda: Estado de Cuenta -->
            <div class="col-lg-5 mb-4">

                @if (deudaActual > 0)
                {
                    <div class="alert alert-danger border-0 d-flex justify-content-between align-items-center rounded-top mb-0" style="border-bottom-left-radius: 0; border-bottom-right-radius: 0;">
                        <span class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Atención Requerida</span>
                        <span class="badge bg-white text-danger">INHABILITADO</span>
                    </div>
                }

                <div class="balance-card @(deudaActual == 0 ? "pagado" : "")" style="@(deudaActual > 0 ? "border-top-left-radius: 0; border-top-right-radius: 0;" : "")">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="opacity-75">Saldo Pendiente</span>
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                    <h1 class="fw-bold mb-1 text-center py-3">$ @deudaActual.ToString("N2")</h1>

                    @if (deudaActual > 0)
                    {
                        <p class="small text-center opacity-75 mb-4">Poseés una deuda por tratamientos anteriores. Por favor, regularizá tu saldo para poder agendar nuevos turnos.</p>
                        <!-- BOTÓN QUE ABRE EL MODAL DE PAGO -->
                        <button class="btn btn-light w-100 fw-bold text-danger rounded-pill py-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalPagarDeuda">
                            <i class="bi bi-credit-card me-2"></i> Pagar Ahora
                        </button>
                    }
                    else
                    {
                        <p class="text-center opacity-75 mb-0"><i class="bi bi-check-circle-fill me-2"></i>Tu cuenta está completamente al día.</p>
                    }
                </div>
            </div>

            <!-- Columna Derecha: Métodos de Pago Guardados -->
            <div class="col-lg-7">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Mis Tarjetas</h5>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3"><i class="bi bi-plus-lg me-1"></i> Agregar</button>
                </div>

                <!-- Tarjeta 1 -->
                <div class="payment-method-card mb-3 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-light p-2 rounded"><i class="bi bi-credit-card-2-front fs-4 text-primary"></i></div>
                        <div>
                            <h6 class="fw-bold mb-0">Visa terminada en 4512</h6>
                            <small class="text-muted">Vence 12/28</small>
                        </div>
                    </div>
                    <span class="badge bg-primary rounded-pill">Principal</span>
                </div>

                <!-- Tarjeta 2 -->
                <div class="payment-method-card shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-light p-2 rounded"><i class="bi bi-credit-card fs-4 text-secondary"></i></div>
                        <div>
                            <h6 class="fw-bold mb-0">Mastercard terminada en 8890</h6>
                            <small class="text-muted">Vence 05/26</small>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
         MODAL: PAGAR DEUDA
         ========================================== -->
    <div class="modal fade" id="modalPagarDeuda" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-wallet2 me-2"></i>Abonar Saldo Pendiente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Formulario que apunta al método POST en tu HomeController -->
                <form asp-controller="Home" asp-action="PagarDeuda" method="post">
                    <div class="modal-body p-4">

                        <div class="text-center mb-4">
                            <span class="text-muted small text-uppercase fw-bold d-block mb-1">Monto a Pagar</span>
                            <h2 class="fw-bold text-dark">$ @deudaActual.ToString("N2")</h2>
                        </div>

                        <label class="form-label fw-bold mb-3">Seleccioná un método de pago</label>

                        <!-- Opción de Tarjeta 1 (Radio Oculto) -->
                        <div class="position-relative mb-2">
                            <input type="radio" class="btn-check tarjeta-radio" name="MetodoPago" id="tarjeta1" value="Visa4512" required>
                            <label class="payment-method-card w-100 m-0 cursor-pointer" for="tarjeta1" style="cursor: pointer;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-light p-2 rounded"><i class="bi bi-credit-card-2-front fs-5 text-primary"></i></div>
                                    <div class="text-start">
                                        <h6 class="fw-bold mb-0 text-dark">Visa terminada en 4512</h6>
                                    </div>
                                </div>
                                <i class="bi bi-check-circle-fill text-primary d-none fs-5 check-icon"></i>
                            </label>
                        </div>

                        <!-- Opción de Tarjeta 2 (Radio Oculto) -->
                        <div class="position-relative mb-4">
                            <input type="radio" class="btn-check tarjeta-radio" name="MetodoPago" id="tarjeta2" value="Mastercard8890">
                            <label class="payment-method-card w-100 m-0 cursor-pointer" for="tarjeta2" style="cursor: pointer;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-light p-2 rounded"><i class="bi bi-credit-card fs-5 text-secondary"></i></div>
                                    <div class="text-start">
                                        <h6 class="fw-bold mb-0 text-dark">Mastercard terminada en 8890</h6>
                                    </div>
                                </div>
                                <i class="bi bi-check-circle-fill text-primary d-none fs-5 check-icon"></i>
                            </label>
                        </div>

                    </div>
                    <div class="modal-footer bg-light border-0 justify-content-between p-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-lock-fill me-1"></i> Confirmar Pago
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script chiquito para mostrar el tilde azul al seleccionar una tarjeta en el Modal -->
    <script>
        document.querySelectorAll('.tarjeta-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                // Ocultar todos los tildes
                document.querySelectorAll('.check-icon').forEach(icon => icon.classList.add('d-none'));
                // Mostrar el tilde de la tarjeta seleccionada
                if(this.checked) {
                    this.nextElementSibling.querySelector('.check-icon').classList.remove('d-none');
                }
            });
        });
    </script>
</body>
</html>