                        <h6 class="fw-bold text-dark">No tenés turnos agendados</h6>
                        <p class="text-muted small mb-3">Te recomendamos un control periódico cada 6 meses.</p>
                        <a href="@Url.Action("Reservar", "Turno")" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm btn-sm">
                            <i class="bi bi-plus-lg me-1"></i> Agendar Cita
                        </a>
                    </div>
                }

                <!-- ESPECIALIDADES ODONTOLÓGICAS (BSQ Pág 3) -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">Especialidades</h5>
                    <small class="text-muted">6 áreas</small>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <a href="@Url.Action("Reservar", "Turno", new { especialidad = "Endodoncia" })" class="specialty-box" data-bs-toggle="tooltip" title="Tratamiento de conducto">
                            <div class="specialty-icon"><i class="bi bi-activity"></i></div>
                            <span class="specialty-label">Endodoncia</span>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="@Url.Action("Reservar", "Turno", new { especialidad = "Ortodoncia" })" class="specialty-box" data-bs-toggle="tooltip" title="Brackets y alineadores">
                            <div class="specialty-icon"><i class="bi bi-grid-3x3-gap"></i></div>
                            <span class="specialty-label">Ortodoncia</span>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="@Url.Action("Reservar", "Turno", new { especialidad = "Cirugía Maxilofacial" })" class="specialty-box" data-bs-toggle="tooltip" title="Extracciones y muelas de juicio">
                            <div class="specialty-icon"><i class="bi bi-tools"></i></div>
                            <span class="specialty-label">Cirugía</span>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="@Url.Action("Reservar", "Turno", new { especialidad = "Implantología" })" class="specialty-box" data-bs-toggle="tooltip" title="Implantes dentales y prótesis">
                            <div class="specialty-icon"><i class="bi bi-shield-plus"></i></div>
                            <span class="specialty-label">Implantología</span>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="@Url.Action("Reservar", "Turno", new { especialidad = "Odontopediatría" })" class="specialty-box" data-bs-toggle="tooltip" title="Atención para niños">
                            <div class="specialty-icon"><i class="bi bi-person-heart"></i></div>
                            <span class="specialty-label">Odontopediatría</span>
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="@Url.Action("Reservar", "Turno", new { especialidad = "Periodoncia" })" class="specialty-box" data-bs-toggle="tooltip" title="Tratamiento de encías">
                            <div class="specialty-icon"><i class="bi bi-bandaid"></i></div>
                            <span class="specialty-label">Periodoncia</span>
                        </a>
                    </div>
                </div>

                <!-- BANNER DE SALUD PREVENTIVA -->
                <div class="tip-banner shadow-sm">
                    <i class="bi bi-lightbulb-fill fs-2"></i>
                    <div>
                        <strong class="d-block small text-uppercase">Cuidado Preventivo</strong>
                        <span class="small" style="line-height: 1.3; display: block;">Recordá cambiar tu cepillo dental cada 3 meses y utilizar hilo dental diariamente.</span>
                    </div>
                </div>

            </div>
        </div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Inicializar Tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Buscador en tiempo real de profesionales
            var buscador = document.getElementById("buscadorEspecialistas");
            if (buscador) {
                buscador.addEventListener("input", function (e) {
                    var filter = e.target.value.toLowerCase();
                    var cards = document.querySelectorAll(".doc-card");
                    cards.forEach(function (card) {
                        var text = card.innerText.toLowerCase();
                        card.style.display = text.includes(filter) ? "" : "none";
                    });
                });
            }
        });
    </script>
}