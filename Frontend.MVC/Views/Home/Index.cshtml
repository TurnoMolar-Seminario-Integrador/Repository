        </div>

        <!-- 2. FILA DE ACCESOS DIRECTOS -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-6">
                <a href="@Url.Action("MisTurnos", "Home")" class="stat-card">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-semibold">Mis Citas</small>
                        <strong class="text-dark">1 Vigente</strong>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="@Url.Action("HistorialClinico", "Home")" class="stat-card">
                    <div class="stat-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-file-earmark-medical-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-semibold">Historial Clínico</small>
                        <strong class="text-dark">Ficha #48291</strong>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="@Url.Action("MetodosDePago", "Home")" class="stat-card">
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-credit-card-2-front-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-semibold">Estado de Cuenta</small>
                        <strong class="text-success">$0.00 (Al día)</strong>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-6">
                <a href="@Url.Action("Seguros", "Home")" class="stat-card">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-shield-fill-check"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block fw-semibold">Obra Social</small>
                        <strong class="text-dark">OSDE Activa</strong>
                    </div>
                </a>
            </div>
        </div>

        <!-- 3. CONTENIDO PRINCIPAL: PROFESIONALES + PRÓXIMO TURNO -->
        <div class="row">

            <!-- COLUMNA IZQUIERDA: Buscador y Profesionales Disponibles -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Encuentra tu Especialista</h4>
                        <p class="text-muted small mb-0">Consulta la disponibilidad de nuestro staff médico odontológico.</p>
                    </div>
                </div>

                <div class="search-container">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="form-control search-input" id="buscadorEspecialistas" placeholder="Buscar por nombre (Ej. Dra. Elena Silva) o especialidad (Ortodoncia, Cirugía)...">
                </div>

                <h6 class="fw-bold text-muted text-uppercase mb-3 small" style="letter-spacing: 0.5px;">Profesionales Disponibles</h6>

                <!-- Profesional 1: Dra. Elena Silva -->
                <div class="doc-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Elena+Silva&background=2563eb&color=fff&bold=true" alt="Dra. Elena Silva" class="doc-avatar me-3">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">Dra. Elena Silva</h5>
                                <span class="text-primary small fw-semibold">Ortodoncia y Endodoncia • MP 4128</span><br>
                                <small class="text-muted"><i class="bi bi-star-fill text-warning me-1"></i>4.9 (124 pacientes atendidos)</small>
                            </div>
                        </div>
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 1 })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                            Ver Agenda
                        </a>
                    </div>
                    <p class="text-muted small mb-2"><i class="bi bi-clock me-1"></i>Próximos turnos libres:</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 1 })" class="slot-pill" data-bs-toggle="tooltip" title="Agendar para Hoy">Hoy, 14:30</a>
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 1 })" class="slot-pill" data-bs-toggle="tooltip" title="Agendar para Mañana">Mañana, 09:00</a>
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 1 })" class="slot-pill" data-bs-toggle="tooltip" title="Agendar para Jueves">Jueves, 11:15</a>
                    </div>
                </div>

                <!-- Profesional 2: Dr. Martín López -->
                <div class="doc-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Martin+Lopez&background=0d9488&color=fff&bold=true" alt="Dr. Martín López" class="doc-avatar me-3">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">Dr. Martín López</h5>
                                <span class="text-teal small fw-semibold" style="color: #0d9488;">Cirugía Maxilofacial e Implantes • MP 5092</span><br>
                                <small class="text-muted"><i class="bi bi-star-fill text-warning me-1"></i>4.8 (89 pacientes atendidos)</small>
                            </div>
                        </div>
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 2 })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                            Ver Agenda
                        </a>
                    </div>
                    <p class="text-muted small mb-2"><i class="bi bi-clock me-1"></i>Próximos turnos libres:</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 2 })" class="slot-pill" data-bs-toggle="tooltip" title="Agendar para Viernes">Viernes, 10:00</a>
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 2 })" class="slot-pill" data-bs-toggle="tooltip" title="Agendar para Lunes">Lunes, 15:30</a>
                    </div>
                </div>

                <!-- Profesional 3: Dra. Karina González -->
                <div class="doc-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Karina+Gonzalez&background=7c3aed&color=fff&bold=true" alt="Dra. Karina González" class="doc-avatar me-3">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">Dra. Karina González</h5>
                                <span class="text-purple small fw-semibold" style="color: #7c3aed;">Odontología General y Prótesis • MP 3840</span><br>
                                <small class="text-muted"><i class="bi bi-star-fill text-warning me-1"></i>5.0 (210 pacientes atendidos)</small>
                            </div>
                        </div>
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 3 })" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                            Ver Agenda
                        </a>
                    </div>
                    <p class="text-muted small mb-2"><i class="bi bi-clock me-1"></i>Próximos turnos libres:</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 3 })" class="slot-pill" data-bs-toggle="tooltip" title="Agendar para Martes">Martes, 11:00</a>
                        <a href="@Url.Action("Reservar", "Turno", new { odontologoId = 3 })" class="slot-pill" data-bs-toggle="tooltip" title="Agendar para Miércoles">Miércoles, 16:30</a>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: Widget de Próximo Turno y Especialidades -->
            <div class="col-lg-4">

                <!-- WIDGET PRÓXIMO TURNO -->
                @if (TempData["OcultarTurno"] == null)
                {
                    <div class="next-turno-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 small fw-bold">
                                <i class="bi bi-pin-angle-fill me-1"></i> Próxima Cita
                            </span>

                            <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Turno+Odontologico+-+Clinica+Dental+Rosario&dates=20261112T123000Z/20261112T130000Z&details=Control+General+con+Dra.+Karina+Gonzalez+en+Consultorio+3&location=Clinica+Dental+Rosario"
                               target="_blank"
                               class="calendar-btn"
                               data-bs-toggle="tooltip"
                               title="Sincronizar con Google Calendar">
                                <i class="bi bi-calendar-plus"></i>
                            </a>
                        </div>

                        <h3 class="fw-extrabold mb-1">12 Nov, 09:30 AM</h3>
                        <p class="mb-1 fw-semibold text-white">Control General</p>
                        <p class="small text-white-50 mb-3"><i class="bi bi-geo-alt me-1"></i>Dra. Karina González • Consultorio 3</p>

                        <div class="d-flex gap-2 mt-2">
                            <a href="@Url.Action("MisTurnos", "Home")" class="btn btn-light w-100 fw-bold text-primary rounded-pill py-2 shadow-sm">
                                <i class="bi bi-eye-fill me-1"></i> Ver Detalle
