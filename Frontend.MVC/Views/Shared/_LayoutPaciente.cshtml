@{
    var nombrePaciente = ViewData["NombrePaciente"]?.ToString() ?? "Manuel Fernández";
    var idPaciente = ViewData["IdPaciente"]?.ToString() ?? "10042";
    var estadoPaciente = ViewData["EstadoPaciente"]?.ToString() ?? "HABILITADO";
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "Inicio";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CSS & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦷</text></svg>">

    <style>
        :root {
            --primary-color: #2563eb;
            --primary-hover: #1d4ed8;
            --dark-navy: #0d3b66;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --bg-app: #f4f7fb;
            --sidebar-width: 260px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-app);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: var(--text-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        /* ==========================================
           SIDEBAR PERMANENTE Y 100% UNIFICADO
           ========================================== */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #ffffff;
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            padding: 24px 18px;
            z-index: 1000;
        }

        .profile-section {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 20px;
            border-bottom: 1px solid #f1f5f9;
            margin-bottom: 20px;
        }

        .profile-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #3b82f6;
            flex-shrink: 0;
        }

        .profile-info h6 {
            font-size: 0.95rem;
            font-weight: 700;
            margin: 0;
            color: #1e293b;
            line-height: 1.2;
        }

        .profile-info small {
            font-size: 0.78rem;
            color: #64748b;
        }

        .badge-habilitado {
            background-color: #dcfce7;
            color: #15803d;
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 700;
            display: inline-block;
            margin-top: 4px;
            letter-spacing: 0.5px;
        }

        .badge-inhabilitado {
            background-color: #fee2e2;
            color: #b91c1c;
            font-size: 0.65rem;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 700;
            display: inline-block;
            margin-top: 4px;
            letter-spacing: 0.5px;
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            gap: 4px;
        }

        .nav-link-custom {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            color: #64748b;
            text-decoration: none;
            border-radius: 10px;
            font-size: 0.92rem;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .nav-link-custom:hover {
            background-color: #f1f5f9;
            color: #2563eb;
            transform: translateX(3px);
        }

        .nav-link-custom.active {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        }

        .nav-link-custom i {
            font-size: 1.1rem;
        }

        /* ==========================================
           CONTENEDOR PRINCIPAL Y HEADER
           ========================================== */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 30px 36px;
            min-height: 100vh;
        }

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .brand-title {
            color: #0f172a;
            font-weight: 800;
            font-size: 1.35rem;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo {
            width: 34px;
            height: auto;
        }

        .btn-bell {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            color: #64748b;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            transition: all 0.2s;
        }

        .btn-bell:hover {
            color: #2563eb;
            border-color: #bfdbfe;
            background: #eff6ff;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- SIDEBAR GLOBAL DEL PACIENTE -->
    <aside class="sidebar">
        <div class="profile-section">
            <img src="https://ui-avatars.com/api/?name=@nombrePaciente&background=2563eb&color=fff&bold=true" alt="Perfil" class="profile-avatar" />
            <div class="profile-info">
                <h6>@nombrePaciente</h6>
                <small>ID: #@idPaciente</small><br>
                @if (estadoPaciente == "INHABILITADO")
                {
                    <span class="badge-inhabilitado">ESTADO: INHABILITADO</span>
                }
                else
                {
                    <span class="badge-habilitado">ESTADO: HABILITADO</span>
                }
            </div>
        </div>

        <ul class="nav-menu">
            <li>
                <a href="@Url.Action("Index", "Home")" class="nav-link-custom @(activeTab == "Inicio" ? "active" : "")">
                    <i class="bi bi-house-door-fill"></i> Inicio
                </a>
            </li>
            <li>
                <a href="@Url.Action("MisTurnos", "Home")" class="nav-link-custom @(activeTab == "MisTurnos" ? "active" : "")">
                    <i class="bi bi-calendar3"></i> Mis Turnos
                </a>
            </li>
            <li>
                <a href="@Url.Action("HistorialClinico", "Home")" class="nav-link-custom @(activeTab == "HistorialClinico" ? "active" : "")">
                    <i class="bi bi-file-medical"></i> Historial Clínico
                </a>
            </li>
            <li>
                <a href="@Url.Action("MetodosDePago", "Home")" class="nav-link-custom @(activeTab == "MetodosDePago" ? "active" : "")">
                    <i class="bi bi-wallet2"></i> Métodos de Pago
                </a>
            </li>
            <li>
                <a href="@Url.Action("Seguros", "Home")" class="nav-link-custom @(activeTab == "Seguros" ? "active" : "")">
                    <i class="bi bi-shield-check"></i> Seguros/Obras Sociales
                </a>
            </li>
            <li>
                <a href="@Url.Action("Configuracion", "Home")" class="nav-link-custom @(activeTab == "Configuracion" ? "active" : "")">
                    <i class="bi bi-gear"></i> Configuración
                </a>
            </li>
            <li style="margin-top: auto;">
                <a href="#" class="nav-link-custom text-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCerrarSesionPaciente">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            </li>
        </ul>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-content">
        <!-- TOP HEADER UNIFICADO -->
        <div class="top-header">
            <h5 class="brand-title">
                <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" class="brand-logo" />
                Clínica Dental Rosario
            </h5>
            <button class="btn btn-bell" data-bs-toggle="tooltip" data-bs-placement="left" title="Sin notificaciones pendientes">
                <i class="bi bi-bell-fill"></i>
            </button>
        </div>

        <!-- CUERPO DE LA VISTA -->
        @RenderBody()
    </main>

    <!-- MODAL CONFIRMACIÓN CERRAR SESIÓN -->
    <div class="modal fade" id="modalCerrarSesionPaciente" tabindex="-1" aria-labelledby="modalCerrarSesionPacLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header text-white border-0 py-3 px-4" style="background: linear-gradient(135deg, #0d3b66 0%, #1d6fa5 100%);">
                    <h5 class="modal-title fw-bold fs-6 d-flex align-items-center gap-2" id="modalCerrarSesionPacLabel">
                        <i class="bi bi-door-open-fill opacity-75"></i> Confirmación de Salida
                    </h5>
                    <button type="button" class="btn-close btn-close-white opacity-75" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 72px; height: 72px; background-color: #eef6ff; color: #0d3b66;">
                            <i class="bi bi-box-arrow-right fs-1" style="margin-left: 3px;"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">¿Querés cerrar sesión?</h5>
                    <p class="text-muted small mb-0 px-2">
                        Serás redirigido a la pantalla de ingreso y tu sesión se cerrará de forma segura.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-center gap-2 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold border shadow-sm" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </button>
                    <a href="@Url.Action("Login", "Home")" class="btn rounded-pill px-4 fw-bold shadow-sm text-white" style="background: linear-gradient(135deg, #0d3b66, #0d6efd); border: none;">
                        <i class="bi bi-box-arrow-right me-1"></i> Sí, Cerrar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
