diff --git a/Frontend.MVC/Views/Shared/_LayoutResponsable.cshtml b/Frontend.MVC/Views/Shared/_LayoutResponsable.cshtml
new file mode 100644
index 0000000..32eacdf
--- /dev/null
+++ b/Frontend.MVC/Views/Shared/_LayoutResponsable.cshtml
@@ -0,0 +1,152 @@
+@{
+    // Layout de la consola del responsable de la clínica. El admin es un responsable con rango
+    // superior y usa la misma consola. El odontólogo tiene la suya (_LayoutOdontologo): cada rol
+    // ve solo sus secciones.
+    var nombreResponsable = User.FindFirst("NombreCompleto")?.Value ?? "Responsable de la Clínica";
+    var esAdmin = User.IsInRole("Admin");
+    var rolResponsable = esAdmin ? "ADMINISTRADOR" : "RESPONSABLE DE LA CLÍNICA";
+    var subtitulo = "Gestión de la clínica";
+    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "PanelPrincipal";
+}
+
+<!DOCTYPE html>
+<html lang="es">
+<head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>@ViewData["Title"]</title>
+    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
+    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
+    <link rel="preconnect" href="https://fonts.googleapis.com">
+    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
+    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦷</text></svg>">
+
+    <link rel="stylesheet" href="~/css/odontologo-layout.css" />
+
+    <style>
+        body {
+            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+            background-color: #f8fafc;
+        }
+
+        .brand-logo { width: 32px; height: auto; }
+
+        .badge-rol {
+            background-color: #e6f0fa;
+            color: #004694;
+            font-size: 0.65rem;
+            padding: 3px 8px;
+            border-radius: 6px;
+            font-weight: 800;
+            display: inline-block;
+            margin-top: 4px;
+            letter-spacing: 0.4px;
+        }
+    </style>
+
+    @RenderSection("Styles", required: false)
+</head>
+<body>
+
+    <!-- SIDEBAR PROFESIONAL UNIFICADO -->
+    <div class="sidebar">
+        <div class="profile-section">
+            <img src="https://ui-avatars.com/api/?name=@nombreResponsable&background=0d6efd&color=fff&bold=true" class="profile-avatar" alt="@nombreResponsable" />
+            <div class="profile-info">
+                <h6>@nombreResponsable</h6>
+                <small>@subtitulo</small><br />
+                <span class="badge-rol">@rolResponsable</span>
+            </div>
+        </div>
+
+        <ul class="nav-menu">
+            <li class="nav-item">
+                <a href="@Url.Action("Index", "Responsable")" class="nav-link @(activeTab == "PanelPrincipal" ? "active" : "")">
+                    <i class="bi bi-grid-1x2"></i> Panel Principal
+                </a>
+            </li>
+            <li class="nav-item">
+                <a href="@Url.Action("TurnosDelDia", "Responsable")" class="nav-link @(activeTab == "TurnosDelDia" ? "active" : "")">
+                    <i class="bi bi-calendar2-day"></i> Turnos del Día
+                </a>
+            </li>
+            <li class="nav-item">
+                <a href="@Url.Action("GestionTurnos", "Responsable")" class="nav-link @(activeTab == "GestionTurnos" ? "active" : "")">
+                    <i class="bi bi-calendar3"></i> Gestión de Turnos
+                </a>
+            </li>
+            <li class="nav-item">
+                <a href="@Url.Action("ControlAsistencias", "Responsable")" class="nav-link @(activeTab == "ControlAsistencias" ? "active" : "")">
+                    <i class="bi bi-clipboard2-check"></i> Control de Asistencias
+                </a>
+            </li>
+            <li class="nav-item" style="margin-top: auto;">
+                <a href="#" class="nav-link text-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCerrarSesionResponsable">
+                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
+                </a>
+            </li>
+        </ul>
+    </div>
+
+    <!-- CONTENIDO PRINCIPAL -->
+    <div class="main-content">
+
+        <!-- TOP HEADER UNIFICADO -->
+        <div class="top-header">
+            <h5 class="brand-title">
+                <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" class="brand-logo" />
+                Clínica Dental Rosario <span class="separator">| Gestión de la Clínica</span>
+            </h5>
+            <div class="d-flex gap-2 align-items-center">
