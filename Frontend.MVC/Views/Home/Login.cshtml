@{
    ViewData["Title"] = "Acceso al Sistema - Clínica Dental Rosario";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        .login-card {
            background-color: #ffffff;
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(13, 59, 102, 0.08);
            border: 1px solid #eaeef2;
        }

        .logo-container {
            text-align: center;
            margin-bottom: 1.8rem;
        }

        .brand-logo {
            width: 70px;
            height: auto;
            margin-bottom: 12px;
            filter: drop-shadow(0 4px 6px rgba(0, 70, 148, 0.15));
        }

        h1 {
            font-size: 1.45rem;
            font-weight: 700;
            color: #0d3b66;
            margin: 0 0 4px 0;
        }

        p.subtitle {
            font-size: 0.85rem;
            color: #64748b;
            margin: 0;
        }

        .form-group {
            margin-bottom: 1.2rem;
            text-align: left;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #334155;
            display: block;
        }

        .input-icon-wrapper {
            position: relative;
        }

        .input-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .form-control-custom {
            width: 100%;
            padding: 11px 14px 11px 42px;
            border: 1.5px solid #cbd5e1;
            border-radius: 10px;
            font-size: 0.95rem;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .form-control-custom:focus {
            border-color: #0d6efd;
            outline: none;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
        }

        .btn-enter {
            background-color: #0d3b66;
            color: #ffffff;
            border: none;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(13, 59, 102, 0.2);
        }

        .btn-enter:hover {
            background-color: #002d62;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(13, 59, 102, 0.25);
        }

        /* Quick Pilot Access Selector */
        .pilot-box {
            background-color: #f8fafc;
            border: 1.5px dashed #cbd5e1;
            border-radius: 12px;
            padding: 14px;
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .pilot-title {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #0d6efd;
            margin-bottom: 8px;
        }

        .pilot-btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .pilot-btn {
            border: 1px solid #cbd5e1;
            background: #ffffff;
            border-radius: 8px;
            padding: 8px 10px;
            font-size: 0.8rem;
            font-weight: 600;
            color: #1e293b;
            text-decoration: none;
            transition: all 0.15s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .pilot-btn:hover {
            border-color: #0d6efd;
            background-color: #eff6ff;
            color: #0d6efd;
            transform: translateY(-2px);
        }

        .pilot-btn small {
            font-size: 0.7rem;
            color: #64748b;
            font-weight: normal;
        }

        .register-link {
            text-align: center;
            font-size: 0.85rem;
            color: #64748b;
            margin-top: 1rem;
        }

        .register-link a {
            color: #0d6efd;
            font-weight: 600;
            text-decoration: none;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        footer {
            margin-top: 2rem;
            font-size: 0.72rem;
            color: #94a3b8;
            text-align: center;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-container">
            <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo Clínica Dental" class="brand-logo" />
            <h1>Clínica Dental Rosario</h1>
            <p class="subtitle">Gestión odontológica profesional</p>
        </div>

        @if (TempData["ErrorLogin"] != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center" role="alert" style="font-size: 0.85rem; border-radius: 8px;">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                <div>@TempData["ErrorLogin"]</div>
            </div>
        }

        <form asp-action="Login" asp-controller="Home" method="post">
            <div class="form-group">
                <label class="form-label">Número de Documento</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person-badge"></i>
                    <input type="text" name="dni" class="form-control-custom" placeholder="Ingresá 1 (Odontólogo) o 2 (Paciente)" autofocus required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Contraseña</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" name="password" class="form-control-custom" placeholder="Tu contraseña" />
                </div>
                <div class="text-end mt-1">
                    <a href="#" style="font-size: 0.78rem; color: #0d6efd; text-decoration: none;">¿Olvidé mi contraseña?</a>
                </div>
            </div>

            <button type="submit" class="btn-enter mt-2">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
            </button>
        </form>

        <!-- Selector de prueba rápida para diferenciar UI Odontólogo vs Paciente -->
        <div class="pilot-box">
            <div class="pilot-title">
                <i class="bi bi-sliders me-1"></i> Modo Prueba Rápida
            </div>
            <div class="pilot-btn-group">
                <a href="@Url.Action("Index", "Odontologo")" class="pilot-btn">
                    <span><strong>1. Odontólogo</strong></span>
                    <small>Dra. Karina González</small>
                </a>
                <a href="@Url.Action("Index", "Home")" class="pilot-btn">
                    <span><strong>2. Paciente</strong></span>
                    <small>Manuel Fernández</small>
                </a>
            </div>
        </div>

        <div class="register-link">
            ¿No tenés una cuenta? <a asp-controller="Paciente" asp-action="Crear">Crear una cuenta</a>
        </div>

        <footer>
            © 2026 Clínica Dental Rosario. Todos los derechos reservados.<br />
            Sistema Integral de Gestión Clínica
        </footer>
    </div>

</body>
</html>
