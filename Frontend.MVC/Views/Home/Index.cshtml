@{
    ViewData["Title"] = "Portal del Paciente - Clínica Dental Rosario";
    ViewData["ActiveTab"] = "Inicio";
    Layout = "_LayoutPaciente";

    var nombrePaciente = ViewData["NombrePaciente"] ?? "Manuel Fernández";
    var idPaciente = ViewData["IdPaciente"] ?? "10042";
    var estadoPaciente = "HABILITADO";
}

@section Styles {
    <style>
        /* Hero Banner de Bienvenida */
        .welcome-hero {
            background: linear-gradient(135deg, #0d3b66 0%, #1e40af 60%, #3b82f6 100%);
            border-radius: 20px;
            padding: 28px 32px;
            color: #ffffff;
            margin-bottom: 28px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(13, 59, 102, 0.15);
        }

        .welcome-hero::after {
            content: "🦷";
            position: absolute;
            right: 25px;
            bottom: -15px;
            font-size: 8rem;
            opacity: 0.12;
            transform: rotate(-15deg);
            pointer-events: none;
        }

        .hero-btn {
            background-color: #ffffff;
            color: #0d3b66;
            font-weight: 700;
            padding: 10px 22px;
            border-radius: 30px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
            transition: all 0.2s;
        }

        .hero-btn:hover {
            background-color: #f8fafc;
            color: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
        }

        /* Quick Stat Cards */
        .stat-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all 0.2s ease;
            text-decoration: none;
            color: inherit;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.04);
            border-color: #cbd5e1;
            color: inherit;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        /* Buscador */
        .search-container {
            position: relative;
            margin-bottom: 24px;
        }

        .search-input {
            padding: 14px 20px 14px 48px;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            background-color: #ffffff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
            font-size: 0.95rem;
            color: #1e293b;
        }

        .search-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }

        .search-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.1rem;
        }

        /* Tarjetas de Odontólogos */
        .doc-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 16px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
            transition: all 0.2s ease;
        }

        .doc-card:hover {
            border-color: #bfdbfe;
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.06);
        }

        .doc-avatar {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
        }

        .slot-pill {
            border: 1px solid #bfdbfe;
            background-color: #eff6ff;
            color: #2563eb;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 20px;
            text-decoration: none;
            transition: all 0.2s;
            display: inline-block;
        }

        .slot-pill:hover {
            background-color: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
            transform: translateY(-1px);
        }

        /* Tarjeta Azul del Próximo Turno */
        .next-turno-card {
            background: linear-gradient(135deg, #0d3b66 0%, #1e40af 100%);
            color: #ffffff;
            border-radius: 18px;
            padding: 24px;
            margin-bottom: 24px;
            box-shadow: 0 8px 20px rgba(13, 59, 102, 0.2);
            position: relative;
        }

        .calendar-btn {
            color: #ffffff;
            font-size: 1.3rem;
            transition: transform 0.2s;
            cursor: pointer;
        }

        .calendar-btn:hover {
            transform: scale(1.15);
            color: #93c5fd;
        }

        /* Especialidades Box */
        .specialty-box {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 16px 10px;
            text-align: center;
            transition: all 0.2s;
            cursor: pointer;
            text-decoration: none;
            display: block;
            height: 100%;
        }

        .specialty-box:hover {
            transform: translateY(-3px);
            border-color: #3b82f6;
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.1);
        }

        .specialty-icon {
            font-size: 1.6rem;
            color: #2563eb;
            margin-bottom: 6px;
        }

        .specialty-label {
            font-size: 0.82rem;
            font-weight: 700;
            color: #475569;
            display: block;
        }

        /* Health Tip Banner */
        .tip-banner {
            background-color: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 16px;
            padding: 18px 22px;
            color: #166534;
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 24px;
        }
    </style>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

        <!-- 1. HERO BANNER DE BIENVENIDA -->
        <div class="welcome-hero">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill small fw-bold mb-2">
                        PORTAL DEL PACIENTE
                    </span>
                    <h2 class="fw-extrabold mb-1">¡Hola, @nombrePaciente!</h2>
                    <p class="text-white-50 mb-3" style="max-width: 540px;">
                        Bienvenido a tu centro de salud odontológica. Gestioná tus citas, consultá tu historial clínico y cuidá tu sonrisa con los mejores profesionales.
                    </p>
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <a href="@Url.Action("Reservar", "Turno")" class="hero-btn">
                            <i class="bi bi-calendar-plus-fill text-primary"></i> Solicitar Nuevo Turno
                        </a>
                        <span class="text-white-50 small">
                            <i class="bi bi-shield-check text-success me-1"></i> Cobertura: <strong>OSDE (Plan 210)</strong>
                        </span>
