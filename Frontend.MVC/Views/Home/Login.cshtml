@{
    ViewData["Title"] = "Acceso al Sistema - Clínica Dental Rosario";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦷</text></svg>">

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        .login-card {
            background-color: #ffffff;
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 15px 35px rgba(13, 59, 102, 0.08);
            border: 1px solid #eaeef2;
        }

        .logo-container {
            text-align: center;
            margin-bottom: 1.8rem;
        }

        .brand-logo {
            width: 70px;
            height: auto;
            margin-bottom: 12px;
            filter: drop-shadow(0 4px 6px rgba(0, 70, 148, 0.15));
        }

        h1 {
            font-size: 1.45rem;
            font-weight: 700;
            color: #0d3b66;
            margin: 0 0 4px 0;
        }

        p.subtitle {
            font-size: 0.85rem;
            color: #64748b;
            margin: 0;
        }

        .form-group {
            margin-bottom: 1.2rem;
            text-align: left;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #334155;
            display: block;
        }

        .input-icon-wrapper {
            position: relative;
        }

        .input-icon-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .form-control-custom {
            width: 100%;
            padding: 11px 14px 11px 42px;
            border: 1.5px solid #cbd5e1;
            border-radius: 10px;
            font-size: 0.95rem;
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .form-control-custom:focus {
            border-color: #0d6efd;
            outline: none;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
        }

        .btn-enter {
            background-color: #0d3b66;
            color: #ffffff;
            border: none;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 10px rgba(13, 59, 102, 0.2);
        }

        .btn-enter:hover {
            background-color: #002d62;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(13, 59, 102, 0.25);
        }

        .register-link {
            text-align: center;
            font-size: 0.85rem;
            color: #64748b;
            margin-top: 1.5rem;
        }

        .register-link a {
            color: #0d6efd;
            font-weight: 600;
            text-decoration: none;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        footer {
            margin-top: 2rem;
            font-size: 0.72rem;
            color: #94a3b8;
            text-align: center;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-container">
            <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo Clínica Dental" class="brand-logo" />
            <h1>Clínica Dental Rosario</h1>
            <p class="subtitle">Gestión odontológica profesional</p>
        </div>

        @if (TempData["ErrorLogin"] != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center" role="alert" style="font-size: 0.85rem; border-radius: 8px;">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                <div>@TempData["ErrorLogin"]</div>
            </div>
        }

        <form asp-action="Login" asp-controller="Home" method="post" id="formLogin">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group">
                <label class="form-label">Tipo de Documento</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person-badge"></i>
                    <select id="inputTipoDocumento" name="tipoDocumento" class="form-control-custom" style="padding-left: 42px;" required>
                        <option value="DNI">DNI</option>
                        <option value="LC">LC</option>
                        <option value="LE">LE</option>
                        <option value="PAS">Pasaporte</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Número de Documento</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-hash"></i>
                    <input type="text" id="inputNroDocumento" name="nroDocumento" class="form-control-custom" autofocus required autocomplete="off" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Contraseña</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock"></i>
                    <input type="password" id="inputPassword" name="password" class="form-control-custom" required />
                </div>
                <div class="text-end mt-1">
                    <a href="#" style="font-size: 0.78rem; color: #0d6efd; text-decoration: none;">¿Olvidé mi contraseña?</a>
                </div>
            </div>

            <button type="submit" class="btn-enter mt-2">
                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
            </button>
        </form>

        <div class="register-link">
            ¿No tenés una cuenta? <a asp-controller="Paciente" asp-action="Crear">Crear una cuenta</a>
        </div>

        <footer>
            © 2026 Clínica Dental Rosario. Todos los derechos reservados.<br />
            Sistema Integral de Gestión Clínica
        </footer>
    </div>

</body>
</html>
