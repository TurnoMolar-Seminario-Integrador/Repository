@{
    var nombreDoctor = User.FindFirst("NombreCompleto")?.Value ?? "Dra. Karina González";
    var rolDoctor = (User.IsInRole("ResponsableClinica") || User.IsInRole("Admin")) 
                    ? "RESPONSABLE CLÍNICO" 
                    : "ODONTÓLOGO";
    var especialidad = "Odontología General";
    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "PanelPrincipal";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦷</text></svg>">

    <link rel="stylesheet" href="~/css/odontologo-layout.css" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f8fafc;
        }

        .brand-logo { width: 32px; height: auto; }

        .badge-rol {
            background-color: #e6f0fa;
            color: #004694;
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 800;
            display: inline-block;
            margin-top: 4px;
            letter-spacing: 0.4px;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- SIDEBAR PROFESIONAL UNIFICADO -->
    <div class="sidebar">
        <div class="profile-section">
            <img src="https://ui-avatars.com/api/?name=@nombreDoctor&background=0d6efd&color=fff&bold=true" class="profile-avatar" alt="@nombreDoctor" />
            <div class="profile-info">
                <h6>@nombreDoctor</h6>
                <small>@especialidad</small><br />
                <span class="badge-rol">@rolDoctor</span>
            </div>
        </div>

        <ul class="nav-menu">
            <li class="nav-item">
                <a href="@Url.Action("Index", "Odontologo")" class="nav-link @(activeTab == "PanelPrincipal" ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i> Panel Principal
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("TurnosDelDia", "Odontologo")" class="nav-link @(activeTab == "TurnosDelDia" ? "active" : "")">
                    <i class="bi bi-calendar2-day"></i> Turnos del Día
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("GestionTurnos", "Odontologo")" class="nav-link @(activeTab == "GestionTurnos" ? "active" : "")">
                    <i class="bi bi-calendar3"></i> Gestión de Turnos
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("ControlAsistencias", "Odontologo")" class="nav-link @(activeTab == "ControlAsistencias" ? "active" : "")">
                    <i class="bi bi-clipboard2-check"></i> Control de Asistencias
                </a>
            </li>
            <li class="nav-item">
                <a href="@Url.Action("GestionAtenciones", "Odontologo")" class="nav-link @(activeTab == "GestionAtenciones" ? "active" : "")">
                    <i class="bi bi-file-earmark-medical"></i> Gestión Atenciones
                </a>
            </li>
            <li class="nav-item" style="margin-top: auto;">
                <a href="#" class="nav-link text-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCerrarSesionOdontologo">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            </li>
        </ul>
    </div>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="main-content">

        <!-- TOP HEADER UNIFICADO -->
        <div class="top-header">
            <h5 class="brand-title">
                <img src="~/images/diente-al-estilo-doodle_78370-4795.avif" alt="Logo" class="brand-logo" />
                Clínica Dental Rosario <span class="separator">| Portal Profesional</span>
            </h5>
            <div class="d-flex gap-2 align-items-center">
                <span class="badge bg-white text-dark border py-2 px-3 shadow-sm rounded-pill me-2">
                    <i class="bi bi-calendar-event text-primary me-1"></i> @DateTime.Now.ToString("dddd, dd 'de' MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))
                </span>
                <button class="btn btn-light rounded-circle shadow-sm position-relative" style="width: 40px; height: 40px;" title="Notificaciones">
                    <i class="bi bi-bell"></i>
                </button>
            </div>
        </div>

        <!-- CUERPO DE LA VISTA -->
        @RenderBody()
    </div>

    <!-- MODAL CERRAR SESIÓN -->
    <div class="modal fade" id="modalCerrarSesionOdontologo" tabindex="-1" aria-labelledby="modalCerrarSesionLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header text-white border-0 py-3 px-4" style="background: linear-gradient(135deg, #0d3b66 0%, #1d6fa5 100%);">
                    <h5 class="modal-title fw-bold fs-6 d-flex align-items-center gap-2" id="modalCerrarSesionLabel">
                        <i class="bi bi-door-open-fill opacity-75"></i> Confirmación de Salida
                    </h5>
                    <button type="button" class="btn-close btn-close-white opacity-75" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 72px; height: 72px; background-color: #eef6ff; color: #0d3b66;">
                            <i class="bi bi-box-arrow-right fs-1" style="margin-left: 3px;"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">¿Querés cerrar sesión?</h5>
                    <p class="text-muted small mb-0 px-2">
                        Al salir, finalizará tu sesión como <strong>@nombreDoctor</strong> y serás redirigido a la pantalla de ingreso.
                    </p>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-center gap-2 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold border shadow-sm" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </button>
                    <a href="@Url.Action("Logout", "Home")" class="btn rounded-pill px-4 fw-bold shadow-sm text-white" style="background: linear-gradient(135deg, #0d3b66, #0d6efd); border: none;">
                        <i class="bi bi-box-arrow-right me-1"></i> Sí, Cerrar Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
